---
import BaseLayout from "@kmra/ui/layouts/BaseLayout.astro";
import ToolGrid from "@kmra/ui/components/ToolGrid.astro";
import PrivacyStrip from "@kmra/ui/components/PrivacyStrip.astro";
import AppCards from "@kmra/ui/components/AppCards.astro";
import Faq from "@kmra/ui/components/Faq.astro";
import LandingDrop from "@kmra/ui/components/LandingDrop";
import Promises from "@kmra/ui/components/Promises.astro";
import { appUrl, getApp } from "@kmra/registry";

const app = getApp("pdftool");
const dev = import.meta.env.DEV;
const faq = [
  {
    q: "Will my PDFs be uploaded?",
    a: "No. Like every kmra tool, PDF tools run entirely in your browser. Contracts, statements and IDs stay on your device.",
  },
  {
    q: "When will the PDF tools be ready?",
    a: "They're being built now, starting with merge and split. Each one appears here as soon as it works.",
  },
  {
    q: "Will there be page or file limits?",
    a: "We won't set any. Very large documents can be slow on phones because the work uses your device's memory.",
  },
];
---

<BaseLayout
  appId="pdftool"
  title="Free PDF tools that run in your browser · kmra"
>
  <div class="hero-band">
    <div class="wrap hero">
      <div>
        <span class="pill">
          <i>Soon</i> PDF tools are being built
        </span>
        <h1 class="display">
          Merge, split and sign PDFs without uploading them.
        </h1>
        <p class="lede">
          Contracts, statements and IDs stay on your device. PDF tools will work
          just like the image tools, with simple and advanced modes.
        </p>
        <div class="ctas">
          <a class="btn acc lg" href={appUrl("imgtool", "/", dev)}>
            Use image tools now
          </a>
          <a class="btn lg" href="/how-it-works">
            How it works
          </a>
        </div>
        <Promises />
      </div>
      <LandingDrop
        client:load
        accept="application/pdf"
        label="Drop PDFs here"
        formats={["PDF"]}
        unavailable="PDF tools aren't ready yet. Your file wasn't opened or uploaded."
      />
    </div>
  </div>

  <div class="wrap">
    <section class="block">
      <div class="sechead primary">
        <h2>PDF tools</h2>
        <p>Each one gets simple and advanced modes.</p>
      </div>
      <ToolGrid tools={app.tools} />
    </section>

    <section class="block">
      <PrivacyStrip />
    </section>

    <section class="block">
      <div class="content" style="padding-top: 0">
        <div class="sechead primary">
          <h2>Questions</h2>
        </div>
        <Faq items={faq} />
      </div>
    </section>
  </div>

  <section class="band-alt">
    <div class="wrap">
      <section class="block">
        <div class="sechead quiet">
          <h2>More from kmra</h2>
          <p>Same privacy, different files.</p>
        </div>
        <AppCards appId="pdftool" others />
      </section>
    </div>
  </section>
</BaseLayout>
