---
import BaseLayout from "@kmra/ui/layouts/BaseLayout.astro";
import ToolShowcase from "@kmra/ui/components/ToolShowcase.astro";
import TaskList from "@kmra/ui/components/TaskList.astro";
import PrivacySection from "@kmra/ui/components/PrivacySection.astro";
import HeroChips from "@kmra/ui/components/HeroChips.astro";
import LandingDrop from "@kmra/ui/components/LandingDrop";
import Icon from "@kmra/ui/components/Icon.astro";
import { getApp } from "@kmra/registry";

const app = getApp("pdftool");
// Eleven popular tasks and an "All use cases" card; the rest are on /use-cases
const popularSlugs = app.popular ?? [];
const tasks = app.tasks
  .slice()
  .sort(
    (a, b) =>
      (popularSlugs.includes(a.slug) ? popularSlugs.indexOf(a.slug) : 99) -
      (popularSlugs.includes(b.slug) ? popularSlugs.indexOf(b.slug) : 99),
  )
  .slice(0, 11);
const icons = Object.fromEntries(app.tools.map((t) => [t.slug, t.icon]));
// A short popular list (tools and tasks); the full set is in the menu and the showcase below
const chips = (app.popular ?? []).flatMap((slug) => {
  const tool = app.tools.find((t) => t.slug === slug && t.ready);
  if (tool) return [{ href: `/${slug}`, label: tool.name, icon: tool.icon }];
  const task = app.tasks.find((t) => t.slug === slug);
  return task
    ? [{ href: `/${slug}`, label: task.name, icon: icons[task.tool] ?? "file" }]
    : [];
});
---

<BaseLayout appId="pdftool" title="Free PDF tools in your browser">
  <section class="hero-band screen">
    <div class="wrap hero-center">
      <h1 class="display">Work on PDFs in your browser</h1>
      <p class="lede">
        Merge, split, compress and sign. Contracts, statements and IDs never
        leave your device.
      </p>
      <LandingDrop
        client:load
        large
        accept="application/pdf"
        label="Drop PDFs here"
        formats={["PDF"]}
        target="/organize"
      />
      <HeroChips items={chips} />
    </div>
  </section>

  <section class="screen">
    <div class="wrap">
      <div class="sechead primary">
        <h2>PDF tools</h2>
        <p>Every tool opens simple. Advanced shows every page.</p>
      </div>
    </div>
    <ToolShowcase tools={app.tools} />
    <div class="wrap showcase-all">
      <a class="btn" href="/tools">
        <Icon name="grid" />
        Browse all {app.tools.filter((t) => t.ready).length} tools
      </a>
    </div>
  </section>

  <section class="screen">
    <div class="wrap stack">
      <div>
        <div class="sechead primary">
          <h2>Popular tasks</h2>
          <p>Ready-made settings for everyday jobs.</p>
        </div>
        <TaskList
          tasks={tasks}
          icons={icons}
          all={{
            href: "/use-cases",
            label: `All ${app.tasks.length} use cases`,
          }}
        />
      </div>
      <PrivacySection />
    </div>
  </section>
</BaseLayout>
