---
import BaseLayout from "@kmra/ui/layouts/BaseLayout.astro";
import ToolHero from "@kmra/ui/components/ToolHero.astro";
import Section from "@kmra/ui/components/Section.astro";
import ToolList from "@kmra/ui/components/ToolList.astro";
import ComingSoon from "@kmra/ui/components/ComingSoon.astro";
import OtherApps from "@kmra/ui/components/OtherApps.astro";
import { getApp, type Tool } from "@kmra/registry";

export function getStaticPaths() {
  return getApp("pdftool").tools.map((tool) => ({
    params: { tool: tool.slug },
    props: { tool },
  }));
}

interface Props {
  tool: Tool;
}

const { tool } = Astro.props;
const app = getApp("pdftool");
---

<BaseLayout
  appId="pdftool"
  title={`${tool.name} · ${app.name} · kmra`}
  description={tool.description}
  current={tool.slug}
>
  <ToolHero app={app} tool={tool} />

  <div class="mx-auto max-w-6xl px-4 pt-10 sm:px-6">
    {!tool.ready && <ComingSoon />}
  </div>

  {tool.steps && (
    <Section title={`How to use ${tool.name}`}>
      <ol class="max-w-2xl space-y-4">
        {tool.steps.map((step, i) => (
          <li class="grid grid-cols-[2rem_1fr] gap-3 leading-relaxed">
            <span class="font-wide font-extrabold text-muted">{i + 1}</span>
            <span>{step}</span>
          </li>
        ))}
      </ol>
    </Section>
  )}

  <Section title={`Other ${app.name.toLowerCase()}`}>
    <ToolList tools={app.tools} exclude={tool.slug} />
  </Section>

  <Section title="More tools">
    <OtherApps appId="pdftool" />
  </Section>
</BaseLayout>
