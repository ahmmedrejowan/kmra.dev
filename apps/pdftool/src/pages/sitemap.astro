---
import BaseLayout from "@kmra/ui/layouts/BaseLayout.astro";
import PageHead from "@kmra/ui/components/PageHead.astro";
import SitemapContent from "@kmra/ui/components/SitemapContent.astro";
import { getApp } from "@kmra/registry";

const app = getApp("pdftool");
---

<BaseLayout
  appId="pdftool"
  title="Sitemap"
  description="Every page and tool on this site."
  og="index"
>
  <PageHead
    crumbs={[{ label: app.name, href: "/" }, { label: "Sitemap" }]}
    icon="layers"
    title="Sitemap"
    intro="Every page and tool on this site."
  />
  <div class="wrap page-body">
    <SitemapContent appId="pdftool" extra={[]} />
  </div>
</BaseLayout>
