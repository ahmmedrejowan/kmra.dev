---
import BaseLayout from "@kmra/ui/layouts/BaseLayout.astro";
import Crumbs from "@kmra/ui/components/Crumbs.astro";
import ToolCards from "@kmra/ui/components/ToolCards.astro";
import InfoCard from "@kmra/ui/components/InfoCard.astro";
import TaskList from "@kmra/ui/components/TaskList.astro";
import SoonBox from "@kmra/ui/components/SoonBox.astro";
import Icon from "@kmra/ui/components/Icon.astro";
import {
  appOrigin,
  brandName,
  getApp,
  type Task,
  type Tool,
} from "@kmra/registry";
import "@fontsource/dancing-script/400.css";
import PdfTool from "../components/PdfTool";
import SignPdf from "../components/SignPdf";
import ImagesToPdf from "../components/ImagesToPdf";

export function getStaticPaths() {
  const app = getApp("pdftool");
  return [
    ...app.tools.map((tool) => ({
      params: { slug: tool.slug },
      props: { tool, task: undefined },
    })),
    ...app.tasks.map((task) => ({
      params: { slug: task.slug },
      props: { tool: app.tools.find((t) => t.slug === task.tool)!, task },
    })),
  ];
}

interface Props {
  tool: Tool;
  task?: Task;
}

const { tool, task } = Astro.props;
// Sign and Image to PDF have their own interface (no Simple/Advanced switch)
const standalone = tool.slug === "sign" || tool.slug === "from-image";
const app = getApp("pdftool");
const title = task?.title ?? tool.title ?? tool.name;
const intro = task?.intro ?? tool.description;
const crumbs = task
  ? [
      { label: app.name, href: "/" },
      { label: tool.name, href: `/${tool.slug}` },
      { label: task.name },
    ]
  : [{ label: app.name, href: "/" }, { label: tool.name }];
// Always three related tasks: this tool's own first, then other popular tasks.
const related = [
  ...app.tasks.filter((t) => t.tool === tool.slug && t.slug !== task?.slug),
  ...app.tasks.filter((t) => t.tool !== tool.slug && t.slug !== task?.slug),
].slice(0, 3);
// Eight other tools: same group first, then the popular ones, then the rest
const popular = app.popular ?? [];
const others = app.tools
  .filter((t) => t.slug !== tool.slug && t.ready)
  .map((t) => ({
    t,
    rank:
      t.group === tool.group
        ? 0
        : popular.includes(t.slug)
          ? 1 + popular.indexOf(t.slug) / 100
          : 2,
  }))
  .sort((a, b) => a.rank - b.rank)
  .slice(0, 8)
  .map((x) => x.t);
const icons = Object.fromEntries(app.tools.map((t) => [t.slug, t.icon]));

const baseFaq = [
  {
    q: "Is my PDF uploaded?",
    a: "No. The PDF is processed in your browser and never leaves your device.",
  },
  standalone
    ? {
        q: "Does it work offline?",
        a: "Yes. Once this page has loaded, it keeps working without an internet connection.",
      }
    : {
        q: "What does Advanced add?",
        a: "Every option at once, many files in one go, and a single zip download.",
      },
  {
    q: "Is there a limit?",
    a: "No limits from us. Very large PDFs can be slow on phones because the work uses your device's memory.",
  },
];
// Task pages lead with their own note, then the general answers; always three items.
const info = task
  ? [{ q: "Good to know", a: task.about[0] ?? "" }, ...baseFaq].slice(0, 3)
  : baseFaq;

// Structured data: the tool as a free web app, its breadcrumb trail and the always-visible Q&A.
const origin = Astro.site?.toString() ?? appOrigin("pdftool");
const pageUrl = new URL(`/${task?.slug ?? tool.slug}`, origin).toString();
const schema = [
  {
    "@context": "https://schema.org",
    "@type": "WebApplication",
    name: title,
    url: pageUrl,
    description: intro,
    applicationCategory: "MultimediaApplication",
    operatingSystem: "Any (runs in the browser)",
    browserRequirements: "Requires a modern browser with JavaScript",
    isAccessibleForFree: true,
    offers: { "@type": "Offer", price: "0", priceCurrency: "USD" },
    publisher: {
      "@type": "Organization",
      name: `${brandName(app)} by kmra.dev`,
      url: origin,
    },
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: crumbs.map((c, i) => ({
      "@type": "ListItem",
      position: i + 1,
      name: c.label,
      ...(c.href
        ? { item: new URL(c.href, origin).toString() }
        : { item: pageUrl }),
    })),
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    mainEntity: info.map((it) => ({
      "@type": "Question",
      name: it.q,
      acceptedAnswer: { "@type": "Answer", text: it.a },
    })),
  },
];
---

<BaseLayout appId="pdftool" title={title} schema={schema} description={intro}>
  <section class="hero-band tool-head">
    <div class="wrap">
      <Crumbs items={crumbs} />
      <div class="ptitle">
        <div class="ptitle-main">
          <span class="tile">
            <Icon name={tool.icon} />
          </span>
          <div>
            <h1>{title}</h1>
            <p>{intro}</p>
          </div>
        </div>
        {tool.ready && !standalone && (
          <div class="modes" role="group" aria-label="Mode">
            <button type="button" aria-pressed="true" data-mode="simple">
              Simple
            </button>
            <button type="button" aria-pressed="false" data-mode="advanced">
              <Icon name="sliders" />
              Advanced
            </button>
          </div>
        )}
      </div>
    </div>
  </section>

  <div class="wrap tool-area">
    {tool.slug === "sign" ? (
      <SignPdf client:load />
    ) : tool.slug === "from-image" ? (
      <ImagesToPdf client:load />
    ) : (
      <PdfTool client:load tool={tool.slug} preset={task?.preset} />
    )}

    {tool.ready && tool.steps && <InfoCard steps={tool.steps} items={info} />}

    <section class="block">
      <div class="sechead primary">
        <h2>Related tasks</h2>
        <p>Ready-made settings for common jobs.</p>
      </div>
      <TaskList tasks={related} icons={icons} />
    </section>

    <section class="block">
      <div class="sechead primary">
        <h2>Other tools</h2>
        <p>More ways to work with PDFs.</p>
      </div>
      <ToolCards
        tools={others}
        allHref="/sitemap"
        allLabel={`All ${app.tools.filter((t) => t.ready).length} PDF tools`}
      />
    </section>
  </div>
</BaseLayout>

<script>
  // Simple/Advanced switch: tells the tool which mode to use and mirrors the mode it reports back.
  const buttons = document.querySelectorAll<HTMLButtonElement>("[data-mode]");
  buttons.forEach((b) =>
    b.addEventListener("click", () =>
      window.dispatchEvent(new CustomEvent(`kmra:${b.dataset.mode}`)),
    ),
  );
  window.addEventListener("kmra:mode", (e) => {
    const advanced = (e as CustomEvent<{ advanced: boolean }>).detail.advanced;
    buttons.forEach((b) =>
      b.setAttribute(
        "aria-pressed",
        String((b.dataset.mode === "advanced") === advanced),
      ),
    );
  });
</script>
