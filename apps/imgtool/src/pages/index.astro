---
import BaseLayout from "@kmra/ui/layouts/BaseLayout.astro";
import ToolGrid from "@kmra/ui/components/ToolGrid.astro";
import TaskList from "@kmra/ui/components/TaskList.astro";
import Trio from "@kmra/ui/components/Trio.astro";
import AppCards from "@kmra/ui/components/AppCards.astro";
import LandingDrop from "@kmra/ui/components/LandingDrop";
import { getApp } from "@kmra/registry";

const app = getApp("imgtool");
---

<BaseLayout
  appId="imgtool"
  title="Free image tools that run in your browser · kmra"
>
  <div class="wrap">
    <div class="hero">
      <div>
        <a class="pill" href="/compress-to-100kb">
          <i>New</i> Compress to an exact file size
        </a>
        <h1 class="display">
          Edit images in your browser. Nothing gets uploaded.
        </h1>
        <p class="lede">
          Resize, compress and convert photos in seconds, one at a time or in
          batches. Switch to Advanced when you need every option.
        </p>
        <div class="ctas">
          <a class="btn primary" href="/compress">
            Start compressing
          </a>
          <a class="btn" href="/how-it-works">
            How it works
          </a>
        </div>
      </div>
      <LandingDrop
        client:load
        accept="image/"
        label="Drop images here"
        formats={["JPG", "PNG", "WebP", "GIF", "AVIF"]}
        target="/compress"
        sample
      />
    </div>

    <section class="block">
      <div class="sechead">
        <h2>Image tools</h2>
        <p>Every tool opens simple. Advanced is one click away.</p>
      </div>
      <ToolGrid tools={app.tools} />
    </section>

    <section class="block">
      <div class="sechead">
        <h2>Popular tasks</h2>
        <p>Ready-made settings for common jobs.</p>
      </div>
      <TaskList tasks={app.tasks} />
    </section>

    <section class="block">
      <Trio />
    </section>

    <section class="block">
      <div class="sechead">
        <h2>More from kmra</h2>
        <p>Same privacy, different files.</p>
      </div>
      <AppCards appId="imgtool" others />
    </section>
  </div>
</BaseLayout>
