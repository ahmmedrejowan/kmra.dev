---
import BaseLayout from "@kmra/ui/layouts/BaseLayout.astro";
import ToolShowcase from "@kmra/ui/components/ToolShowcase.astro";
import TaskDirectory from "@kmra/ui/components/TaskDirectory.astro";
import PrivacySection from "@kmra/ui/components/PrivacySection.astro";
import HeroChips from "@kmra/ui/components/HeroChips.astro";
import LandingDrop from "@kmra/ui/components/LandingDrop";
import { getApp } from "@kmra/registry";

const app = getApp("imgtool");
const icons = Object.fromEntries(app.tools.map((t) => [t.slug, t.icon]));
// A short popular list (tools and tasks); the full set is in the menu and the showcase below
const chips = (app.popular ?? []).flatMap((slug) => {
  const tool = app.tools.find((t) => t.slug === slug && t.ready);
  if (tool) return [{ href: `/${slug}`, label: tool.name, icon: tool.icon }];
  const task = app.tasks.find((t) => t.slug === slug);
  return task
    ? [{ href: `/${slug}`, label: task.name, icon: icons[task.tool] ?? "file" }]
    : [];
});
const count = app.tools.filter((t) => t.ready).length;
---

<BaseLayout
  appId="imgtool"
  title="Free image tools in your browser"
  alternates={[{ lang: "bn", path: "/bn" }]}
>
  <section class="hero-band screen">
    <div class="wrap hero-center">
      <h1 class="display">Edit images in your browser</h1>
      <p class="lede">
        Compress, convert, cut out backgrounds and {count - 3} more tools.
        Nothing gets uploaded.
      </p>
      <LandingDrop
        client:load
        large
        accept="image/"
        label="Drop images here"
        formats={["JPG", "PNG", "WebP", "HEIC", "GIF", "AVIF"]}
        target="/editor"
      />
      <HeroChips items={chips} />
      <a class="langswitch hero-lang" href="/bn" hreflang="bn" lang="bn">
        বাংলায় ফর্মের ছবি ঠিক করুন
      </a>
    </div>
  </section>

  <section class="screen">
    <div class="wrap">
      <div class="sechead primary">
        <h2>Image tools</h2>
        <p>Every tool opens simple. Advanced is one click away.</p>
      </div>
    </div>
    <ToolShowcase tools={app.tools} />
  </section>

  <section class="screen">
    <div class="wrap stack">
      <div>
        <div class="sechead primary">
          <h2>Popular tasks</h2>
          <p>Ready-made settings for everyday jobs.</p>
        </div>
        <TaskDirectory tasks={app.tasks} icons={icons} />
      </div>
      <PrivacySection />
    </div>
  </section>
</BaseLayout>
