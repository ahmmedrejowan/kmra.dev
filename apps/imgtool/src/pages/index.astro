---
import BaseLayout from "@kmra/ui/layouts/BaseLayout.astro";
import ToolShowcase from "@kmra/ui/components/ToolShowcase.astro";
import TaskDirectory from "@kmra/ui/components/TaskDirectory.astro";
import PrivacyBand from "@kmra/ui/components/PrivacyBand.astro";
import AppCards from "@kmra/ui/components/AppCards.astro";
import Promises from "@kmra/ui/components/Promises.astro";
import Icon from "@kmra/ui/components/Icon.astro";
import { getApp } from "@kmra/registry";
import HeroPreview from "../components/HeroPreview";

const app = getApp("imgtool");
const icons = Object.fromEntries(app.tools.map((t) => [t.slug, t.icon]));
---

<BaseLayout
  appId="imgtool"
  title="Free image tools that run in your browser · kmra"
>
  <div class="hero-band">
    <div class="wrap hero">
      <div>
        <a class="pill" href="/compress-to-100kb">
          <i>New</i> Compress to an exact file size
        </a>
        <h1 class="display">
          Edit images in your browser. Nothing gets uploaded.
        </h1>
        <p class="lede">
          Resize, compress and convert photos in seconds, one at a time or in
          batches. Switch to Advanced when you need every option.
        </p>
        <div class="ctas">
          <button class="btn acc lg" type="button" data-upload>
            <Icon name="upload" />
            Upload images
          </button>
          <a class="btn lg" href="/how-it-works">
            How it works
          </a>
        </div>
        <Promises />
      </div>
      <HeroPreview client:load />
    </div>
  </div>

  <div class="wrap">
    <section class="block">
      <div class="sechead primary">
        <h2>Image tools</h2>
        <p>Every tool opens simple. Advanced is one click away.</p>
      </div>
      <ToolShowcase tools={app.tools} />
    </section>
  </div>

  <TaskDirectory
    tasks={app.tasks}
    icons={icons}
    title="Popular tasks"
    intro="Ready-made settings for jobs people do every day."
  />

  <PrivacyBand
    file="beach-sunset.jpg"
    page="compress"
    engine="image.worker.js"
  />

  <div class="wrap">
    <section class="block">
      <div class="sechead quiet">
        <h2>More from kmra</h2>
        <p>Same privacy, different files.</p>
      </div>
      <AppCards appId="imgtool" others />
    </section>
  </div>
</BaseLayout>

<script>
  document
    .querySelectorAll("[data-upload]")
    .forEach((b) =>
      b.addEventListener("click", () =>
        window.dispatchEvent(new CustomEvent("kmra:upload")),
      ),
    );
</script>
