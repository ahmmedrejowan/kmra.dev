---
import "@fontsource/noto-sans-bengali/400.css";
import "@fontsource/noto-sans-bengali/600.css";
import "@fontsource/noto-sans-bengali/700.css";
import BaseLayout from "@kmra/ui/layouts/BaseLayout.astro";
import PrivacySection from "@kmra/ui/components/PrivacySection.astro";
import Icon from "@kmra/ui/components/Icon.astro";
import LandingDrop from "@kmra/ui/components/LandingDrop";
import { getApp, type IconName } from "@kmra/registry";
import { BN_HOME, BN_PAGES, BN_TOOLS, BN_UI } from "../../i18n/bn";

const app = getApp("imgtool");
const icon = (s: string): IconName => {
  const tk = app.tasks.find((t) => t.slug === s);
  return app.tools.find((t) => t.slug === (tk?.tool ?? s))?.icon ?? "file";
};
const card = (s: string) => ({
  slug: s,
  name: BN_PAGES[s]!.name,
  hint: BN_PAGES[s]!.intro.split("।")[0],
  icon: icon(s),
});
---

<BaseLayout
  appId="imgtool"
  lang="bn"
  title={BN_UI.heroTitle}
  description={BN_UI.tagline}
  og="index"
  alternates={[{ lang: "en", path: "/" }]}
>
  <section class="hero-band screen">
    <div class="wrap hero-center">
      <a class="langswitch top" href="/" hreflang="en" lang="en">
        {BN_UI.english}
      </a>
      <h1 class="display bn">{BN_UI.heroTitle}</h1>
      <p class="lede">{BN_UI.heroLede}</p>
      <LandingDrop
        client:load
        large
        accept="image/"
        label="এখানে ছবি ছেড়ে দিন"
        formats={["JPG", "PNG", "WebP", "HEIC"]}
        target="/bn/photo-300x300-100kb"
        text={{
          hint: "অথবা পেস্ট করুন। কোনো ছবি আপলোড হয় না।",
          button: "ছবি বেছে নিন",
          over: "ছেড়ে দিন",
        }}
      />
    </div>
  </section>

  <section class="screen">
    <div class="wrap stack">
      <div>
        <div class="sechead primary">
          <h2>{BN_UI.tasks}</h2>
          <p>{BN_UI.tasksLede}</p>
        </div>
        <div class="tasks three">
          {BN_HOME.map(card).map((c) => (
            <a class="task" href={`/bn/${c.slug}`}>
              <span class="tile">
                <Icon name={c.icon} />
              </span>
              <span class="task-text">
                <strong>{c.name}</strong>
                <small>{c.hint}</small>
              </span>
              <Icon name="right" class="ico go" />
            </a>
          ))}
        </div>
      </div>
      <div>
        <div class="sechead primary">
          <h2>{BN_UI.tools}</h2>
          <p>
            <a href="/sitemap" lang="en">
              {BN_UI.allTools}
            </a>
          </p>
        </div>
        <div class="tasks three">
          {BN_TOOLS.map(card).map((c) => (
            <a class="task" href={`/bn/${c.slug}`}>
              <span class="tile">
                <Icon name={c.icon} />
              </span>
              <span class="task-text">
                <strong>{c.name}</strong>
                <small>{c.hint}</small>
              </span>
              <Icon name="right" class="ico go" />
            </a>
          ))}
        </div>
      </div>
      <PrivacySection />
    </div>
  </section>
</BaseLayout>
