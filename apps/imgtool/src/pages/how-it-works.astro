---
import BaseLayout from "@kmra/ui/layouts/BaseLayout.astro";
import Crumbs from "@kmra/ui/components/Crumbs.astro";
import HowItWorks from "@kmra/ui/components/HowItWorks.astro";
import AppCards from "@kmra/ui/components/AppCards.astro";
import Icon from "@kmra/ui/components/Icon.astro";
import { getApp } from "@kmra/registry";

const app = getApp("imgtool");
---

<BaseLayout
  appId="imgtool"
  title="How kmra keeps your images on your device · kmra"
  description="kmra tools run in your browser. Your files are never uploaded, and the site is technically blocked from sending them anywhere."
>
  <section class="hero-band tool-head">
    <div class="wrap">
      <Crumbs
        items={[{ label: app.name, href: "/" }, { label: "How it works" }]}
      />
      <div class="ptitle">
        <div class="ptitle-main">
          <span class="tile">
            <Icon name="shield" />
          </span>
          <div>
            <h1>How kmra keeps your files on your device</h1>
            <p>
              Most online tools upload your file to a server. kmra sends the
              tool to your browser instead.
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>
  <div class="wrap">
    <HowItWorks />
    <section class="block">
      <div class="sechead primary">
        <h2>All kmra apps</h2>
      </div>
      <AppCards appId="imgtool" />
    </section>
  </div>
</BaseLayout>
