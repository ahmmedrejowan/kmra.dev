---
import BaseLayout from "@kmra/ui/layouts/BaseLayout.astro";
import Crumbs from "@kmra/ui/components/Crumbs.astro";
import ToolCards from "@kmra/ui/components/ToolCards.astro";
import InfoCard from "@kmra/ui/components/InfoCard.astro";
import MoreAppsCta from "@kmra/ui/components/MoreAppsCta.astro";
import TaskList from "@kmra/ui/components/TaskList.astro";
import SoonBox from "@kmra/ui/components/SoonBox.astro";
import Icon from "@kmra/ui/components/Icon.astro";
import { getApp, type Task, type Tool } from "@kmra/registry";
import ImageTool from "../components/ImageTool";

export function getStaticPaths() {
  const app = getApp("imgtool");
  return [
    ...app.tools.map((tool) => ({
      params: { slug: tool.slug },
      props: { tool, task: undefined },
    })),
    ...app.tasks.map((task) => ({
      params: { slug: task.slug },
      props: { tool: app.tools.find((t) => t.slug === task.tool)!, task },
    })),
  ];
}

interface Props {
  tool: Tool;
  task?: Task;
}

const { tool, task } = Astro.props;
const app = getApp("imgtool");
const title = task?.title ?? tool.title ?? tool.name;
const intro = task?.intro ?? tool.description;
const crumbs = task
  ? [
      { label: app.name, href: "/" },
      { label: tool.name, href: `/${tool.slug}` },
      { label: task.name },
    ]
  : [{ label: app.name, href: "/" }, { label: tool.name }];
// Always three related tasks: this tool's own first, then other popular tasks.
const related = [
  ...app.tasks.filter((t) => t.tool === tool.slug && t.slug !== task?.slug),
  ...app.tasks.filter((t) => t.tool !== tool.slug && t.slug !== task?.slug),
].slice(0, 3);
const others = app.tools.filter((t) => t.slug !== tool.slug && t.ready);
const icons = Object.fromEntries(app.tools.map((t) => [t.slug, t.icon]));
const railTools = app.tools.map(({ slug, name, icon, ready }) => ({
  slug,
  name,
  icon,
  ready,
}));

const baseFaq = [
  {
    q: "Is my image uploaded?",
    a: "No. It's processed in your browser and never leaves your device.",
  },
  {
    q: "What does Advanced add?",
    a: "Every option at once, many files in one go, and a single zip download.",
  },
  {
    q: "Is there a limit?",
    a: "No limits from us. Very large images can be slow on phones because the work uses your device's memory.",
  },
];
// Task pages lead with their own note, then the general answers; always three items.
const info = task
  ? [{ q: "Good to know", a: task.about[0] ?? "" }, ...baseFaq].slice(0, 3)
  : baseFaq;
---

<BaseLayout appId="imgtool" title={`${title} · kmra`} description={intro}>
  <section class="hero-band tool-head">
    <div class="wrap">
      <Crumbs items={crumbs} />
      <div class="ptitle">
        <div class="ptitle-main">
          <span class="tile">
            <Icon name={tool.icon} />
          </span>
          <div>
            <h1>{title}</h1>
            <p>{intro}</p>
          </div>
        </div>
        {tool.ready && (
          <div class="modes" role="group" aria-label="Mode">
            <button type="button" aria-pressed="true">
              Simple
            </button>
            <button type="button" aria-pressed="false" data-advanced>
              <Icon name="sliders" />
              Advanced
            </button>
          </div>
        )}
      </div>
    </div>
  </section>

  <div class="wrap tool-area">
    {tool.ready ? (
      <ImageTool
        client:load
        tool={tool.slug}
        preset={task?.preset}
        tools={railTools}
      />
    ) : (
      <SoonBox tool={tool} cta={{ label: "Try Compress", href: "/compress" }} />
    )}

    {tool.ready && tool.steps && <InfoCard steps={tool.steps} items={info} />}

    <section class="block">
      <div class="sechead primary">
        <h2>Related tasks</h2>
        <p>Ready-made settings for common jobs.</p>
      </div>
      <TaskList tasks={related} icons={icons} />
    </section>

    <section class="block">
      <div class="sechead primary">
        <h2>Other tools</h2>
        <p>More ways to edit your images.</p>
      </div>
      <ToolCards tools={others} allHref="/" allLabel="All image tools" />
    </section>

    <section class="block">
      <MoreAppsCta appId="imgtool" />
    </section>
  </div>
</BaseLayout>

<script>
  document
    .querySelector("[data-advanced]")
    ?.addEventListener("click", () =>
      window.dispatchEvent(new CustomEvent("kmra:advanced")),
    );
</script>
