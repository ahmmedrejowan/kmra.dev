---
import BaseLayout from "@kmra/ui/layouts/BaseLayout.astro";
import PageHead from "@kmra/ui/components/PageHead.astro";
import HowItWorks from "@kmra/ui/components/HowItWorks.astro";
import PrivacyContent from "@kmra/ui/components/PrivacyContent.astro";
import AboutContent from "@kmra/ui/components/AboutContent.astro";
import AllTools from "@kmra/ui/components/AllTools.astro";
import UseCases from "@kmra/ui/components/UseCases.astro";
import MoreTools from "@kmra/ui/components/MoreTools.astro";
import { brandName, getApp, localizeApp } from "@kmra/registry";
import { pageLocale } from "@kmra/ui/lib/locale";
import { lp, t as tr } from "@kmra/ui/lib/i18n";
import ImageTool from "../components/ImageTool";

/** The non-tool pages, in any language. */
interface Props {
  page:
    | "how-it-works"
    | "privacy"
    | "about"
    | "tools"
    | "use-cases"
    | "more-tools"
    | "editor";
}

const { page } = Astro.props;
const locale = pageLocale(Astro);
const T = (s: string, v?: Record<string, string | number>) => tr(locale, s, v);
const app = localizeApp(getApp("imgtool"), locale);
const brand = brandName(app);
const home = { label: app.name, href: lp(locale, "/") };

const PAGES = {
  "how-it-works": {
    title: T("How your files stay on your device"),
    description: T(
      "kmra tools run in your browser. Your files stay on your device, and the site is blocked from sending them anywhere.",
    ),
    crumb: T("How it works"),
    icon: "shield",
    intro: T(
      "Most online tools send your file to a server. kmra sends the tool to your browser instead.",
    ),
    og: undefined,
  },
  privacy: {
    title: T("Privacy"),
    description: T(
      "Your files stay on your device. No accounts, no cookies. What kmra stores, and what it doesn't.",
    ),
    crumb: T("Privacy"),
    icon: "shield",
    intro: T(
      "Short version: your files never leave your device, and nothing identifies you.",
    ),
    og: undefined,
  },
  about: {
    title: T("About"),
    description: T("Small, private tools for everyday files, from kmra.dev."),
    crumb: T("About"),
    icon: "layers",
    intro: T("Small, private tools for everyday files."),
    og: undefined,
  },
  tools: {
    title: T("All image tools"),
    description: T(
      "Every image tool on ImgTool, by category. All free, and everything runs on your device.",
    ),
    crumb: T("All tools"),
    icon: "grid",
    intro: T(
      "Every tool, by category. All free, and everything runs on your device.",
    ),
    og: undefined,
  },
  "use-cases": {
    title: T("Use cases"),
    description: T(
      "Ready-made settings for everyday jobs: form photos, exact KB sizes, social media and more.",
    ),
    crumb: T("Use cases"),
    icon: "layers",
    intro: T(
      "Ready-made settings for everyday jobs. Pick one and drop your file.",
    ),
    og: undefined,
  },
  "more-tools": {
    title: T("More tools from kmra"),
    description: T(
      "Free, private tools for images, PDFs, video, audio, QR codes, text in pictures, code, colours, calculations and music. Everything runs on your device.",
    ),
    crumb: T("More tools"),
    icon: "zap",
    intro: T("The same free, private tools for other kinds of files."),
    og: undefined,
  },
  editor: {
    title: T("Image editor"),
    description: T(
      "Resize, crop, rotate, compress and convert many images at once, all in your browser.",
    ),
    crumb: T("Editor"),
    icon: "sliders",
    intro: T("Every tool in one workspace. Drop images to start."),
    og: "index",
  },
} as const;
const p = PAGES[page];
const railTools = app.tools.map(({ slug, name, icon, ready }) => ({
  slug,
  name,
  icon,
  ready,
}));
---

<BaseLayout
  appId="imgtool"
  title={p.title}
  description={p.description}
  og={p.og}
>
  <PageHead
    crumbs={[home, { label: p.crumb }]}
    icon={p.icon}
    title={page === "about" ? T("About {brand}", { brand }) : p.title}
    intro={p.intro}
  />
  {page === "editor" ? (
    <div class="wrap tool-area">
      <ImageTool client:load lang={locale} tool="editor" tools={railTools} />
    </div>
  ) : (
    <div class="wrap page-body">
      {page === "how-it-works" && <HowItWorks />}
      {page === "privacy" && <PrivacyContent brand={brand} ai />}
      {page === "about" && <AboutContent />}
      {page === "tools" && <AllTools appId="imgtool" />}
      {page === "use-cases" && <UseCases appId="imgtool" />}
      {page === "more-tools" && <MoreTools appId="imgtool" />}
    </div>
  )}
</BaseLayout>
