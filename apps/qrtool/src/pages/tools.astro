---
import BaseLayout from "@kmra/ui/layouts/BaseLayout.astro";
import PageHead from "@kmra/ui/components/PageHead.astro";
import AllTools from "@kmra/ui/components/AllTools.astro";
import { getApp } from "@kmra/registry";

const app = getApp("qrtool");
---

<BaseLayout
  appId="qrtool"
  title="All QR tools"
  description="Every QR tool, by category. All free, and everything runs on your device."
>
  <PageHead
    crumbs={[{ label: app.name, href: "/" }, { label: "All tools" }]}
    icon="grid"
    title="All QR tools"
    intro="Every QR tool, by category. All free, and everything runs on your device."
  />
  <div class="wrap page-body">
    <AllTools appId="qrtool" />
  </div>
</BaseLayout>
