---
import type { AppId } from "@kmra/registry";
import ToolCards from "./ToolCards.astro";
import { pageLocale } from "../lib/locale";
import { t as tr } from "../lib/i18n";
import { toolSections } from "../lib/sections";

/** Every tool of an app, as card grids grouped by category (anchors: /tools#<group>). */
interface Props {
  appId: AppId;
}

const { appId } = Astro.props;
const locale = pageLocale(Astro);
const groups = toolSections(appId, locale);
const total = groups.reduce((a, g) => a + g.items.length, 0);
---

{groups.map(({ id, label, items }) => (
  <section class="block cat" id={id}>
    <div class="sechead primary">
      <h2>{label}</h2>
      <p>{tr(locale, "{n} tools", { n: items.length })}</p>
    </div>
    <ToolCards tools={items} />
  </section>
))}
<p class="muted cat-count">{tr(locale, "{n} tools in all", { n: total })}</p>
