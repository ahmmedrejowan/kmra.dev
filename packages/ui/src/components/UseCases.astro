---
import { getApp, localizeApp, type AppId } from "@kmra/registry";
import TaskList from "./TaskList.astro";
import { pageLocale } from "../lib/locale";
import { t as tr } from "../lib/i18n";
import { taskSections } from "../lib/sections";

/** Every use case (task page) of an app, grouped (anchors: /use-cases#<group>). */
interface Props {
  appId: AppId;
}

const { appId } = Astro.props;
const locale = pageLocale(Astro);
const app = localizeApp(getApp(appId), locale);
const icons = Object.fromEntries(app.tools.map((t) => [t.slug, t.icon]));
const groups = taskSections(appId, locale);
---

{groups.map(({ id, label, items }) => (
  <section class="block cat" id={id}>
    <div class="sechead primary">
      <h2>{label}</h2>
      <p>{tr(locale, "{n} use cases", { n: items.length })}</p>
    </div>
    <TaskList tasks={items} icons={icons} />
  </section>
))}
