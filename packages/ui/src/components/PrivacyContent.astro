---
import { CONTACT } from "@kmra/registry";
import Icon from "./Icon.astro";

interface Props {
  brand: string;
  /** Mention the on-device AI models (image tools) */
  ai?: boolean;
}

const { brand, ai = false } = Astro.props;
const updated = "8 October 2026";
---

<div class="psum">
  <div>
    <span class="tile">
      <Icon name="shield" />
    </span>
    <strong>Files stay on your device</strong>
    <span>Never uploaded, by us or anyone.</span>
  </div>
  <div>
    <span class="tile">
      <Icon name="check" />
    </span>
    <strong>No accounts</strong>
    <span>Nothing to sign up for.</span>
  </div>
  <div>
    <span class="tile">
      <Icon name="lock" />
    </span>
    <strong>No cookies</strong>
    <span>No ads, no tracking scripts.</span>
  </div>
  <div>
    <span class="tile">
      <Icon name="layers" />
    </span>
    <strong>Anonymous page counts</strong>
    <span>Visits only, never your files.</span>
  </div>
</div>

<div class="policy">
  <section>
    <h2>Your files</h2>
    <p>
      {brand} processes files in your browser. Files you open are read, edited
      and saved on your device. They're never uploaded, and the site's security
      policy blocks it from sending your data to other servers.
    </p>
  </section>
  {ai && (
    <section>
      <h2>AI features</h2>
      <p>
        Background removal, face blur and passport framing use small AI models
        that run on your device. The first time you use one, the model downloads
        from this site, the same way the page itself does, and your browser
        caches it. Your photos are never sent anywhere to be processed.
      </p>
    </section>
  )}
  <section>
    <h2>What your browser keeps</h2>
    <p>
      A few settings are saved in your own browser so the site remembers them.
      We can't see them.
    </p>
    <ul>
      <li>
        <strong>Theme</strong>: light or dark.
      </li>
      <li>
        <strong>Mode</strong>: Simple or Advanced.
      </li>
      <li>
        <strong>Dropped files</strong>: kept briefly so the tool page can open
        them, then deleted.
      </li>
    </ul>
  </section>
  <section>
    <h2>Analytics</h2>
    <p>
      We use Vercel Web Analytics to count visits: which pages are viewed, the
      referring site, and the country, browser and device type. It sets no
      cookies, doesn't identify you, and never sees your files or their names.
    </p>
  </section>
  <section>
    <h2>Hosting</h2>
    <p>
      The site is hosted on Vercel. Like any web host, it may keep standard
      request logs (such as IP address, browser and page) to keep the service
      running and secure. These never include your files.
    </p>
  </section>
  <section>
    <h2>Changes</h2>
    <p>
      If anything here changes, we'll update this page. Last updated {updated}.
    </p>
  </section>
  <section>
    <h2>Contact</h2>
    <p>
      Questions about privacy? Email{" "}
      <a href={`mailto:${CONTACT.email}`}>{CONTACT.email}</a>.
    </p>
  </section>
</div>
