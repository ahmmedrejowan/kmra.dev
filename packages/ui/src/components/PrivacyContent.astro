---
import { CONTACT } from "@kmra/registry";
import Icon from "./Icon.astro";
import { pageLocale } from "../lib/locale";
import { t as tr } from "../lib/i18n";

interface Props {
  brand: string;
  /** Mention the on-device AI models (image tools) */
  ai?: boolean;
}

const { brand, ai = false } = Astro.props;
const locale = pageLocale(Astro);
const T = (s: string, v?: Record<string, string>) => tr(locale, s, v);
const updated = T("21 October 2026");
---

<div class="psum">
  <div>
    <span class="tile">
      <Icon name="shield" />
    </span>
    <strong>{T("Files stay on your device")}</strong>
    <span>{T("They're opened and edited right in your browser.")}</span>
  </div>
  <div>
    <span class="tile">
      <Icon name="check" />
    </span>
    <strong>{T("No accounts")}</strong>
    <span>{T("Nothing to sign up for.")}</span>
  </div>
  <div>
    <span class="tile">
      <Icon name="lock" />
    </span>
    <strong>{T("No cookies")}</strong>
    <span>{T("No ads, no tracking scripts.")}</span>
  </div>
  <div>
    <span class="tile">
      <Icon name="layers" />
    </span>
    <strong>{T("Anonymous page counts")}</strong>
    <span>{T("Visits only, never your files.")}</span>
  </div>
</div>

<div class="policy">
  <section>
    <h2>{T("Your files")}</h2>
    <p>
      {T(
        "{brand} processes files in your browser. Files you open are read, edited and saved on your device; they don't go to any server, and the site's security policy blocks it from sending your data elsewhere.",
        { brand },
      )}
    </p>
  </section>
  {ai && (
    <section>
      <h2>{T("AI features")}</h2>
      <p>
        {T(
          "Background removal, face blur and passport framing use small AI models that run on your device. The first time you use one, the model downloads from this site, the same way the page itself does, and your browser caches it. Your photos are never sent anywhere to be processed.",
        )}
      </p>
    </section>
  )}
  <section>
    <h2>{T("What your browser keeps")}</h2>
    <p>
      {T(
        "A few settings are saved in your own browser so the site remembers them. We can't see them.",
      )}
    </p>
    <ul>
      <li>
        <strong>{T("Theme")}</strong>: {T("light or dark.")}
      </li>
      <li>
        <strong>{T("Mode")}</strong>: {T("Simple or Advanced.")}
      </li>
      <li>
        <strong>{T("Dropped files")}</strong>:{" "}
        {T("kept briefly so the tool page can open them, then deleted.")}{" "}
        {T(
          "A file you drop on kmra.dev is passed to the tool's site the same way, inside your browser.",
        )}
      </li>
    </ul>
  </section>
  <section>
    <h2>{T("Analytics")}</h2>
    <p>
      {T(
        "We use Vercel Web Analytics to count visits: which pages are viewed, the referring site, and the country, browser and device type. It sets no cookies, doesn't identify you, and never sees your files or their names.",
      )}
    </p>
  </section>
  <section>
    <h2>{T("Check it yourself")}</h2>
    <p>
      {T(
        "kmra.dev is open source, so anyone can read how each tool handles files:",
      )}{" "}
      <a href={CONTACT.source} rel="noopener" target="_blank">
        {T("the code on GitHub")}
      </a>
      {locale === "bn" ? "।" : "."}
    </p>
  </section>
  <section>
    <h2>{T("Hosting")}</h2>
    <p>
      {T(
        "The site is hosted on Vercel. Like any web host, it may keep standard request logs (such as IP address, browser and page) to keep the service running and secure. These never include your files.",
      )}
    </p>
  </section>
  <section>
    <h2>{T("Changes")}</h2>
    <p>
      {T(
        "If anything here changes, we'll update this page. Last updated {date}.",
        { date: updated },
      )}
    </p>
  </section>
  <section>
    <h2>{T("Contact")}</h2>
    <p>
      {T("Questions about privacy? Email")}{" "}
      <a href={`mailto:${CONTACT.email}`}>{CONTACT.email}</a>
      {locale === "bn" ? "।" : "."}
    </p>
  </section>
</div>
