---
import {
  apps,
  CONTACT,
  getApp,
  HUB,
  issueUrl,
  localizeApp,
  type App,
  type AppId,
} from "@kmra/registry";
import Icon from "./Icon.astro";
import Wordmark from "./Wordmark.astro";
import { markSvg } from "../lib/brand";
import { appLink, hubLink, langLinks, pageLocale } from "../lib/locale";
import { lp, t as tr } from "../lib/i18n";
import { taskSections, toolSections } from "../lib/sections";

interface Props {
  appId: AppId;
}

const { appId } = Astro.props;
const locale = pageLocale(Astro);
const T = (s: string, v?: Record<string, string | number>) => tr(locale, s, v);
const L = (p: string) => lp(locale, p);
const app = localizeApp(getApp(appId), locale);
const dev = import.meta.env.DEV;
// Other languages of this page (the switcher only shows when there's more than one)
const langs = langLinks(Astro, app);
// Only apps that are live are listed; others appear once they launch.
const liveApps = apps.filter((a) => a.live);
// Menus show the top few of each group (popular first) and link to the full pages
const TOOLS_PER_GROUP = 3;
const TASKS_PER_GROUP = 4;
const taskIcon = Object.fromEntries(app.tools.map((t) => [t.slug, t.icon]));
const toolSecs = toolSections(appId, locale, true);
const taskSecs = taskSections(appId, locale, true);
const readyCount = app.tools.filter((t) => t.ready).length;
const popular = app.popular ?? [];
const rank = (slug: string) =>
  popular.includes(slug) ? popular.indexOf(slug) : 999;
const drawerTools = app.tools
  .filter((t) => t.ready)
  .sort((a, b) => rank(a.slug) - rank(b.slug))
  .slice(0, 8);
const toolIcon = (slug: string) =>
  app.tools.find((t) => t.slug === slug)?.icon ?? "file";
const appHref = (a: App) =>
  a.live ? appLink(appId, locale, a.id as AppId, "/", dev) : undefined;
---

<header class="site">
  <div class="wrap">
    <div class="hd">
      <span class="logo-wrap">
        <a
          class="logo"
          href={L("/")}
          aria-label={T("{brand} home", { brand: app.brand.join("") })}
        >
          <Wordmark appId={appId} dom={false} />
        </a>
        {HUB.live ? (
          <a
            class="wm-dom"
            href={hubLink(locale, "/", dev)}
            title={T("Every app on kmra.dev")}
          >
            kmra.dev
          </a>
        ) : (
          <span class="wm-dom">kmra.dev</span>
        )}
      </span>

      <nav aria-label={T("Main")} style="display: contents">
        <div class="menu">
          <button type="button" aria-expanded="false" aria-controls="m-tools">
            {T("Tools")} <Icon name="down" />
          </button>
          <div
            class="mega cols"
            id="m-tools"
            style={`--cols: ${Math.min(4, toolSecs.length)}`}
            hidden
          >
            {toolSecs.map((sec) => (
              <div class="mgrp">
                <h6>{sec.label}</h6>
                {sec.items.slice(0, TOOLS_PER_GROUP).map((t) => (
                  <a class="mi" href={L(`/${t.slug}`)}>
                    <span class="tile">
                      <Icon name={t.icon} />
                    </span>
                    <span>
                      <strong>{t.name}</strong>
                      <small>{t.blurb}</small>
                    </span>
                  </a>
                ))}
                {sec.items.length > TOOLS_PER_GROUP && (
                  <a class="mi-more" href={L(`/tools#${sec.id}`)}>
                    {T("+ {n} more", { n: sec.items.length - TOOLS_PER_GROUP })}
                  </a>
                )}
              </div>
            ))}
            <a class="mega-all" href={L("/tools")}>
              <Icon name="grid" />
              {T("All {n} tools", { n: readyCount })}
              <Icon name="right" />
            </a>
          </div>
        </div>

        {taskSecs.length > 0 && (
          <div class="menu">
            <button type="button" aria-expanded="false" aria-controls="m-tasks">
              {T("Use cases")} <Icon name="down" />
            </button>
            <div
              class="mega cols tasks-menu"
              id="m-tasks"
              style={`--cols: ${Math.min(4, taskSecs.length)}`}
              hidden
            >
              {taskSecs.map((sec) => (
                <div class="mgrp">
                  <h6>{sec.label}</h6>
                  {sec.items.slice(0, TASKS_PER_GROUP).map((t) => (
                    <a class="mi-task" href={L(`/${t.slug}`)} title={t.name}>
                      <span class="tile">
                        <Icon name={taskIcon[t.tool] ?? "file"} />
                      </span>
                      <span class="mi-task-text">
                        <strong>{t.name}</strong>
                        <small>{t.short}</small>
                      </span>
                      <Icon name="right" class="ico go" />
                    </a>
                  ))}
                  {sec.items.length > TASKS_PER_GROUP && (
                    <a class="mi-more" href={L(`/use-cases#${sec.id}`)}>
                      {T("+ {n} more", {
                        n: sec.items.length - TASKS_PER_GROUP,
                      })}
                    </a>
                  )}
                </div>
              ))}
              <a class="mega-all" href={L("/use-cases")}>
                <Icon name="layers" />
                {T("All {n} use cases", { n: app.tasks.length })}
                <Icon name="right" />
              </a>
            </div>
          </div>
        )}

        <div class="menu">
          <button type="button" aria-expanded="false" aria-controls="m-apps">
            {T("Apps")} <Icon name="down" />
          </button>
          <div class="mega apps-menu" id="m-apps" hidden>
            <div class="apps-head">
              <h6>{T("kmra apps")}</h6>
              <span class="apps-more">
                <a href={L("/more-tools")}>{T("See all kmra tools")}</a>
                {HUB.live && (
                  <a href={hubLink(locale, "/", dev)}>
                    {T("Every app on kmra.dev")}
                  </a>
                )}
              </span>
            </div>
            {liveApps.map((raw) => {
              const a = localizeApp(raw, locale);
              const ready = a.tools.filter((t) => t.ready).length;
              const here = a.id === appId;
              return (
                <a
                  class:list={["app-item", { here }]}
                  href={appHref(a)}
                  aria-current={here ? "true" : undefined}
                  style={`--app:${a.accent.light}`}
                >
                  <span
                    class="app-item-mark"
                    set:html={markSvg(a.id, a.accent.light)}
                    aria-hidden="true"
                  />
                  <span class="app-item-text">
                    <span class="app-item-name">
                      <span
                        set:html={`<span style="color:var(--app)">${a.brand[0]}</span>${a.brand[1]}`}
                      />
                      {here && <span class="here-tag">{T("You're here")}</span>}
                    </span>
                    <small>
                      {a.tagline.split(/[.।]/)[0]}
                      {locale === "bn" ? "।" : "."}
                    </small>
                    <span class="app-item-meta">
                      <span>
                        {ready > 0
                          ? T("{n} tools", { n: ready })
                          : T("In progress")}
                      </span>
                      <span>{a.id}.kmra.dev</span>
                    </span>
                  </span>
                </a>
              );
            })}
          </div>
        </div>

        <a class="navlink" href={L("/how-it-works")}>
          {T("How it works")}
        </a>
        <a
          class="navlink"
          href={CONTACT.source}
          rel="noopener"
          target="_blank"
          title={T("kmra.dev is open source")}
        >
          <Icon name="github" />
          GitHub
        </a>
      </nav>

      <div class="right">
        <button
          class="kbtn"
          type="button"
          data-palette
          aria-label={T("Search tools")}
        >
          <Icon name="search" />
          <span>{T("Search tools")}</span>
          <kbd data-keys="mod+K">⌘K</kbd>
        </button>
        {langs.length > 1 && (
          <div class="menu lang">
            <button
              type="button"
              class="iconbtn"
              aria-expanded="false"
              aria-controls="m-lang"
              aria-label={T("Language")}
              title={T("Language")}
            >
              <Icon name="languages" />
            </button>
            <div class="mega single lang-menu" id="m-lang" hidden>
              <h6>{T("Language")}</h6>
              {langs.map((l) => (
                <a
                  class="mi"
                  href={l.href}
                  hreflang={l.code}
                  lang={l.code}
                  aria-current={l.current ? "true" : undefined}
                >
                  <span>
                    <strong>{l.native}</strong>
                    {l.native !== l.name && <small>{l.name}</small>}
                  </span>
                  {l.current && <Icon name="check" class="ico lang-check" />}
                </a>
              ))}
            </div>
          </div>
        )}
        <button
          class="iconbtn"
          type="button"
          id="theme-toggle"
          aria-label={T("Switch light or dark theme")}
        >
          <Icon name="moon" class="ico theme-moon" />
          <Icon name="sun" class="ico theme-sun" />
        </button>
        <button
          class="iconbtn burger"
          type="button"
          id="burger"
          aria-label={T("Menu")}
          aria-expanded="false"
          aria-controls="drawer"
        >
          <Icon name="menu" />
        </button>
      </div>
    </div>

    <nav class="drawer" id="drawer" aria-label={T("Menu")} hidden>
      {langs.length > 1 && (
        <>
          <h6>{T("Language")}</h6>
          <div class="drawer-langs">
            {langs.map((l) => (
              <a
                href={l.href}
                hreflang={l.code}
                lang={l.code}
                aria-current={l.current ? "true" : undefined}
              >
                {l.native}
              </a>
            ))}
          </div>
        </>
      )}
      <h6>{T("Popular tools")}</h6>
      {drawerTools.map((t) => (
        <a href={L(`/${t.slug}`)}>{t.name}</a>
      ))}
      <a class="drawer-all" href={L("/tools")}>
        {T("All {n} tools", { n: readyCount })}
      </a>
      {app.tasks.length > 0 && (
        <a class="drawer-all" href={L("/use-cases")}>
          {T("All {n} use cases", { n: app.tasks.length })}
        </a>
      )}
      <h6>{T("Apps")}</h6>
      {liveApps.map((a) => {
        const href = appHref(a);
        return href ? (
          <a href={href}>
            <span class="appdot" style={`background:${a.accent.light}`} />
            {localizeApp(a, locale).name}
          </a>
        ) : (
          <span
            class="muted"
            style="display:flex;gap:8px;align-items:center;padding:7px 0"
          >
            <span class="appdot" style={`background:${a.accent.light}`} />
            {a.name} <span class="soon">Soon</span>
          </span>
        );
      })}
      <h6>{T("About")}</h6>
      <a href={L("/how-it-works")}>{T("How it works")}</a>
      <a href={L("/privacy")}>{T("Privacy")}</a>
      <a href={L("/about")}>{T("About")}</a>
      <a href={CONTACT.source} rel="noopener" target="_blank">
        {T("Source code on GitHub")}
      </a>
      <a href={issueUrl("bug")} rel="noopener" target="_blank">
        {T("Report a problem")}
      </a>
    </nav>
  </div>
</header>

<style is:global>
  .theme-sun {
    display: none;
  }
  :root[data-theme="dark"] .theme-sun {
    display: block;
  }
  :root[data-theme="dark"] .theme-moon {
    display: none;
  }
  @media (prefers-color-scheme: dark) {
    :root:not([data-theme="light"]) .theme-sun {
      display: block;
    }
    :root:not([data-theme="light"]) .theme-moon {
      display: none;
    }
  }
</style>

<script>
  const menus = () => [
    ...document.querySelectorAll<HTMLButtonElement>(".menu > button"),
  ];
  function setMenu(btn: HTMLButtonElement, open: boolean) {
    btn.setAttribute("aria-expanded", String(open));
    const panel = document.getElementById(
      btn.getAttribute("aria-controls") ?? "",
    );
    if (panel) panel.hidden = !open;
  }
  const closeAll = (except?: Element) =>
    menus().forEach((b) => b !== except && setMenu(b, false));

  document.addEventListener("click", (e) => {
    const target = e.target as Element;
    const btn = target.closest<HTMLButtonElement>(".menu > button");
    if (btn) {
      closeAll(btn);
      setMenu(btn, btn.getAttribute("aria-expanded") !== "true");
      return;
    }
    if (!target.closest(".mega")) closeAll();
  });
  document.addEventListener("keydown", (e) => {
    if (e.key === "Escape") closeAll();
  });

  const burger = document.getElementById("burger")!;
  const drawer = document.getElementById("drawer")!;
  burger.addEventListener("click", () => {
    drawer.hidden = !drawer.hidden;
    burger.setAttribute("aria-expanded", String(!drawer.hidden));
  });

  document.getElementById("theme-toggle")!.addEventListener("click", () => {
    const root = document.documentElement;
    const isDark = root.dataset.theme
      ? root.dataset.theme === "dark"
      : matchMedia("(prefers-color-scheme: dark)").matches;
    root.dataset.theme = isDark ? "light" : "dark";
    try {
      localStorage.setItem("kmra-theme", root.dataset.theme);
    } catch {}
  });

  document
    .querySelectorAll("[data-palette]")
    .forEach((b) =>
      b.addEventListener("click", () =>
        window.dispatchEvent(new CustomEvent("kmra:palette")),
      ),
    );
</script>
