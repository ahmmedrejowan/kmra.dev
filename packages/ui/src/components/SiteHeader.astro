---
import {
  apps,
  getApp,
  groupBy,
  linkTo,
  type App,
  type AppId,
} from "@kmra/registry";
import Icon from "./Icon.astro";
import Wordmark from "./Wordmark.astro";
import { markSvg } from "../lib/brand";

interface Props {
  appId: AppId;
}

const { appId } = Astro.props;
const app = getApp(appId);
const dev = import.meta.env.DEV;
// Only apps that are live are listed; others appear once they launch.
const liveApps = apps.filter((a) => a.live);
const toolGroups = groupBy(
  app.tools.filter((t) => t.ready),
  app.toolGroups,
);
const taskGroups = groupBy(app.tasks);
const toolIcon = (slug: string) =>
  app.tools.find((t) => t.slug === slug)?.icon ?? "file";
const appHref = (a: App) =>
  a.live ? linkTo(appId, a.id as AppId, "/", dev) : undefined;
---

<header class="site">
  <div class="wrap">
    <div class="hd">
      <a
        class="logo"
        href="/"
        aria-label={`${app.brand.join("")} by kmra.dev, home`}
      >
        <Wordmark appId={appId} />
      </a>

      <nav aria-label="Main" style="display: contents">
        <div class="menu">
          <button type="button" aria-expanded="false" aria-controls="m-tools">
            Tools <Icon name="down" />
          </button>
          <div class="mega cols" id="m-tools" hidden>
            {toolGroups.map(([group, tools]) => (
              <div class="mgrp">
                <h6>{group}</h6>
                {tools.map((t) => (
                  <a class="mi" href={`/${t.slug}`}>
                    <span class="tile">
                      <Icon name={t.icon} />
                    </span>
                    <span>
                      <strong>
                        {t.name}
                        {!t.ready && <span class="soon">Soon</span>}
                      </strong>
                      <small>{t.blurb}</small>
                    </span>
                  </a>
                ))}
              </div>
            ))}
          </div>
        </div>

        {taskGroups.length > 0 && (
          <div class="menu">
            <button type="button" aria-expanded="false" aria-controls="m-tasks">
              Use cases <Icon name="down" />
            </button>
            <div class="mega cols" id="m-tasks" hidden>
              {taskGroups.map(([group, tasks]) => (
                <div class="mgrp">
                  <h6>{group}</h6>
                  {tasks.map((t) => (
                    <a class="mi" href={`/${t.slug}`}>
                      <span class="tile">
                        <Icon name={toolIcon(t.tool)} />
                      </span>
                      <span>
                        <strong>{t.name}</strong>
                        <small>{t.short}</small>
                      </span>
                    </a>
                  ))}
                </div>
              ))}
            </div>
          </div>
        )}

        <div class="menu">
          <button type="button" aria-expanded="false" aria-controls="m-apps">
            Apps <Icon name="down" />
          </button>
          <div class="mega apps-menu" id="m-apps" hidden>
            <h6>kmra apps</h6>
            {liveApps.map((a) => {
              const ready = a.tools.filter((t) => t.ready).length;
              const here = a.id === appId;
              return (
                <a
                  class:list={["app-item", { here }]}
                  href={appHref(a)}
                  aria-current={here ? "true" : undefined}
                  style={`--app:${a.accent.light}`}
                >
                  <span
                    class="app-item-mark"
                    set:html={markSvg(a.id, a.accent.light)}
                    aria-hidden="true"
                  />
                  <span class="app-item-text">
                    <span class="app-item-name">
                      <span
                        set:html={`<span style="color:var(--app)">${a.brand[0]}</span>${a.brand[1]}`}
                      />
                      {here && <span class="here-tag">You're here</span>}
                    </span>
                    <small>{a.tagline.split(".")[0]}.</small>
                    <span class="app-item-meta">
                      <span>
                        {ready > 0 ? `${ready} tools` : "In progress"}
                      </span>
                      <span>{a.id}.kmra.dev</span>
                    </span>
                  </span>
                </a>
              );
            })}
            <a class="apps-more" href="/about">
              About kmra and what's next
            </a>
          </div>
        </div>

        <a class="navlink" href="/how-it-works">
          How it works
        </a>
      </nav>

      <div class="right">
        <button
          class="kbtn"
          type="button"
          data-palette
          aria-label="Search tools"
        >
          <Icon name="search" />
          <span>Search tools</span>
          <kbd data-keys="mod+K">⌘K</kbd>
        </button>
        <button
          class="iconbtn"
          type="button"
          id="theme-toggle"
          aria-label="Switch light or dark theme"
        >
          <Icon name="moon" class="ico theme-moon" />
          <Icon name="sun" class="ico theme-sun" />
        </button>
        <button
          class="iconbtn burger"
          type="button"
          id="burger"
          aria-label="Menu"
          aria-expanded="false"
          aria-controls="drawer"
        >
          <Icon name="menu" />
        </button>
      </div>
    </div>

    <nav class="drawer" id="drawer" aria-label="Menu" hidden>
      <h6>Tools</h6>
      {app.tools.map((t) => (
        <a href={`/${t.slug}`}>
          {t.name}
          {!t.ready && <span class="soon">Soon</span>}
        </a>
      ))}
      {app.tasks.length > 0 && (
        <>
          <h6>Use cases</h6>
          {app.tasks.map((t) => (
            <a href={`/${t.slug}`}>{t.name}</a>
          ))}
        </>
      )}
      <h6>Apps</h6>
      {liveApps.map((a) => {
        const href = appHref(a);
        return href ? (
          <a href={href}>
            <span class="appdot" style={`background:${a.accent.light}`} />
            {a.name}
          </a>
        ) : (
          <span
            class="muted"
            style="display:flex;gap:8px;align-items:center;padding:7px 0"
          >
            <span class="appdot" style={`background:${a.accent.light}`} />
            {a.name} <span class="soon">Soon</span>
          </span>
        );
      })}
      <h6>About</h6>
      <a href="/how-it-works">How it works</a>
      <a href="/privacy">Privacy</a>
      <a href="/about">About</a>
    </nav>
  </div>
</header>

<style is:global>
  .theme-sun {
    display: none;
  }
  :root[data-theme="dark"] .theme-sun {
    display: block;
  }
  :root[data-theme="dark"] .theme-moon {
    display: none;
  }
  @media (prefers-color-scheme: dark) {
    :root:not([data-theme="light"]) .theme-sun {
      display: block;
    }
    :root:not([data-theme="light"]) .theme-moon {
      display: none;
    }
  }
</style>

<script>
  const menus = () => [
    ...document.querySelectorAll<HTMLButtonElement>(".menu > button"),
  ];
  function setMenu(btn: HTMLButtonElement, open: boolean) {
    btn.setAttribute("aria-expanded", String(open));
    const panel = document.getElementById(
      btn.getAttribute("aria-controls") ?? "",
    );
    if (panel) panel.hidden = !open;
  }
  const closeAll = (except?: Element) =>
    menus().forEach((b) => b !== except && setMenu(b, false));

  document.addEventListener("click", (e) => {
    const target = e.target as Element;
    const btn = target.closest<HTMLButtonElement>(".menu > button");
    if (btn) {
      closeAll(btn);
      setMenu(btn, btn.getAttribute("aria-expanded") !== "true");
      return;
    }
    if (!target.closest(".mega")) closeAll();
  });
  document.addEventListener("keydown", (e) => {
    if (e.key === "Escape") closeAll();
  });

  const burger = document.getElementById("burger")!;
  const drawer = document.getElementById("drawer")!;
  burger.addEventListener("click", () => {
    drawer.hidden = !drawer.hidden;
    burger.setAttribute("aria-expanded", String(!drawer.hidden));
  });

  document.getElementById("theme-toggle")!.addEventListener("click", () => {
    const root = document.documentElement;
    const isDark = root.dataset.theme
      ? root.dataset.theme === "dark"
      : matchMedia("(prefers-color-scheme: dark)").matches;
    root.dataset.theme = isDark ? "light" : "dark";
    try {
      localStorage.setItem("kmra-theme", root.dataset.theme);
    } catch {}
  });

  document
    .querySelectorAll("[data-palette]")
    .forEach((b) =>
      b.addEventListener("click", () =>
        window.dispatchEvent(new CustomEvent("kmra:palette")),
      ),
    );
</script>
