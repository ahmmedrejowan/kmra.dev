---
import type { Tool } from "@kmra/registry";
import ToolCard from "./ToolCard.astro";

interface Props {
  tools: readonly Tool[];
}

const { tools } = Astro.props;
const live = tools.filter((t) => t.ready);
const half = Math.ceil(live.length / 2);
const rows = [live.slice(0, half), live.slice(half)].filter((r) => r.length);
// Each row is repeated so the track is at least twice the viewport; it then scrolls by half its width.
const REPEAT = 4;
---

<div class="marquee">
  {rows.map((row, ri) => (
    <div class:list={["mq-row", { rev: ri % 2 === 1 }]}>
      <div class="mq-track">
        {Array.from({ length: REPEAT }, (_, copy) =>
          row.map((t) => <ToolCard tool={t} hidden={copy > 0} />),
        )}
      </div>
    </div>
  ))}
</div>
