---
import { CONTACT, issueUrl } from "@kmra/registry";
import Icon from "./Icon.astro";
import { pageLocale } from "../lib/locale";
import { t as tr } from "../lib/i18n";

const locale = pageLocale(Astro);
const T = (s: string, v?: Record<string, string>) => tr(locale, s, v);
---

<div class="about-lede">
  <p>
    {T(
      "kmra.dev is a family of small, focused tools for everyday files: images, PDFs, video, audio, QR codes, text in pictures, code, colours, calculations and music. Each app lives on its own subdomain and does its work in your browser, so it's fast and your files stay private.",
    )}
  </p>
</div>

<div class="principles">
  <div>
    <span class="tile">
      <Icon name="shield" />
    </span>
    <strong>{T("Private by design")}</strong>
    <p>
      {T(
        "Everything runs on your device, with no accounts. The tool comes to your file.",
      )}
    </p>
  </div>
  <div>
    <span class="tile">
      <Icon name="check" />
    </span>
    <strong>{T("Only what works")}</strong>
    <p>{T("A tool appears here when it's finished, not before.")}</p>
  </div>
  <div>
    <span class="tile">
      <Icon name="zap" />
    </span>
    <strong>{T("Fast and free")}</strong>
    <p>{T("No queues, no watermarks, no limits we set.")}</p>
  </div>
  <div>
    <span class="tile">
      <Icon name="sliders" />
    </span>
    <strong>{T("Simple first")}</strong>
    <p>{T("Two or three controls by default. Advanced when you need it.")}</p>
  </div>
</div>

<section class="block oss">
  <div class="oss-head">
    <span class="tile">
      <Icon name="github" />
    </span>
    <div>
      <h2>{T("Open source")}</h2>
      <p>
        {T(
          "Every kmra.dev site is open source under the AGPL-3.0 licence. Anyone can read how a tool handles files, check that nothing leaves the device, and run their own copy. If you run a changed copy for others, you share its source the same way.",
        )}
      </p>
    </div>
  </div>
  <div class="oss-ways">
    <a href={issueUrl("bug")} rel="noopener" target="_blank">
      <strong>{T("Report a problem")}</strong>
      <span>{T("A tool that doesn't work as it should, on any site.")}</span>
    </a>
    <a href={issueUrl("idea")} rel="noopener" target="_blank">
      <strong>{T("Suggest a tool")}</strong>
      <span>
        {T(
          "A job you'd like a tool for. Ideas people ask for twice get built.",
        )}
      </span>
    </a>
    <a href={CONTACT.discussions} rel="noopener" target="_blank">
      <strong>{T("Ask a question")}</strong>
      <span>{T("How to do something, or whether a tool can do it.")}</span>
    </a>
    <a
      href={`${CONTACT.source}/blob/main/docs/translations.md`}
      rel="noopener"
      target="_blank"
    >
      <strong>{T("Help translate")}</strong>
      <span>
        {T("Fix a translation, or bring the sites to a new language.")}
      </span>
    </a>
    <a
      href={`${CONTACT.source}/blob/main/CONTRIBUTING.md`}
      rel="noopener"
      target="_blank"
    >
      <strong>{T("Contribute code")}</strong>
      <span>{T("Fix a bug or build a tool: pull requests are welcome.")}</span>
    </a>
    <a
      href={`${CONTACT.source}/security/advisories/new`}
      rel="noopener"
      target="_blank"
    >
      <strong>{T("Report a security issue")}</strong>
      <span>
        {T("Privately, so it can be fixed before anyone else knows.")}
      </span>
    </a>
  </div>
  <a class="btn acc" href={CONTACT.source} rel="noopener" target="_blank">
    <Icon name="github" />
    {T("Source code on GitHub")}
  </a>
</section>

<section class="block">
  <div class="maker">
    <div>
      <h2>{T("Who makes it")}</h2>
      <p>
        {T(
          "kmra.dev is built and run by {maker}. Ideas, bugs or a tool you'd like to see? Get in touch.",
          { maker: CONTACT.maker },
        )}
      </p>
    </div>
    <div class="maker-links">
      <a class="btn acc" href={`mailto:${CONTACT.email}`}>
        <Icon name="mail" />
        {CONTACT.email}
      </a>
      <a class="btn" href={CONTACT.portfolio} rel="noopener" target="_blank">
        rejowan.com
      </a>
      <a class="btn" href={CONTACT.linkedin} rel="noopener" target="_blank">
        LinkedIn
      </a>
    </div>
  </div>
</section>
