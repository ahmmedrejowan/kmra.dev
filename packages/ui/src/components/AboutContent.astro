---
import { CONTACT } from "@kmra/registry";
import Icon from "./Icon.astro";
---

<div class="about-lede">
  <p>
    kmra.dev is a family of small, focused tools for everyday files: images and
    PDFs today, QR codes next. Each one lives on its own subdomain and does its
    work in your browser, so it's fast and your files stay private.
  </p>
</div>

<div class="principles">
  <div>
    <span class="tile">
      <Icon name="shield" />
    </span>
    <strong>Private by design</strong>
    <p>No uploads, no accounts. The tool comes to your file.</p>
  </div>
  <div>
    <span class="tile">
      <Icon name="check" />
    </span>
    <strong>Only what works</strong>
    <p>A tool appears here when it's finished, not before.</p>
  </div>
  <div>
    <span class="tile">
      <Icon name="zap" />
    </span>
    <strong>Fast and free</strong>
    <p>No queues, no watermarks, no limits we set.</p>
  </div>
  <div>
    <span class="tile">
      <Icon name="sliders" />
    </span>
    <strong>Simple first</strong>
    <p>Two or three controls by default. Advanced when you need it.</p>
  </div>
</div>

<section class="block">
  <div class="maker">
    <div>
      <h2>Who makes it</h2>
      <p>
        kmra.dev is built and run by {CONTACT.maker}. Ideas, bugs or a tool
        you'd like to see? Get in touch.
      </p>
    </div>
    <div class="maker-links">
      <a class="btn acc" href={`mailto:${CONTACT.email}`}>
        <Icon name="mail" />
        {CONTACT.email}
      </a>
      <a class="btn" href={CONTACT.portfolio} rel="noopener" target="_blank">
        rejowan.com
      </a>
      <a class="btn" href={CONTACT.linkedin} rel="noopener" target="_blank">
        LinkedIn
      </a>
    </div>
  </div>
</section>
