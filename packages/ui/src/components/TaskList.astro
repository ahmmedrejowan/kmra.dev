---
import type { IconName, Task } from "@kmra/registry";
import Icon from "./Icon.astro";
import { pageLocale } from "../lib/locale";
import { lp } from "../lib/i18n";

interface Props {
  tasks: readonly Task[];
  /** Icon for each task's tool */
  icons: Record<string, IconName>;
  /** Last card: a link to every use case */
  all?: { href: string; label: string };
}

const { tasks, icons, all } = Astro.props;
const locale = pageLocale(Astro);
---

<div class="tasks">
  {tasks.map((t) => (
    <a class="task" href={lp(locale, `/${t.slug}`)}>
      <span class="tile">
        <Icon name={icons[t.tool] ?? "file"} />
      </span>
      <span class="task-text">
        <strong>{t.name}</strong>
        <small>{t.short}</small>
      </span>
      <Icon name="right" class="ico go" />
    </a>
  ))}
  {all && (
    <a class="task task-all" href={lp(locale, all.href)}>
      <span class="tile">
        <Icon name="layers" />
      </span>
      <span class="task-text">
        <strong>{all.label}</strong>
      </span>
      <Icon name="right" class="ico go" />
    </a>
  )}
</div>
