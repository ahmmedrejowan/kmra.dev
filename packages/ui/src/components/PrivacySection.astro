---
import { CONTACT } from "@kmra/registry";
import Icon from "./Icon.astro";
import { pageLocale } from "../lib/locale";
import { t as tr } from "../lib/i18n";

/** `noFiles`: the app works on what you type (calculators, colours), not files */
interface Props {
  noFiles?: boolean;
  /** With noFiles: the app listens through the microphone (music) */
  listens?: boolean;
}
const { noFiles = false, listens = false } = Astro.props;
const locale = pageLocale(Astro);
const T = (s: string) => tr(locale, s);
---

<div class="safe">
  <div class="safe-head">
    <span class="tile">
      <Icon name="shield" />
    </span>
    <div>
      <h2>
        {listens
          ? T("What you play stays on your device")
          : noFiles
            ? T("What you type stays on your device")
            : T("Your files never leave your device")}
      </h2>
      <p>{T("Everything runs in your browser.")}</p>
    </div>
  </div>
  <ul>
    <li>
      <Icon name="check" />
      {T("Runs on your device")}
    </li>
    <li>
      <Icon name="check" />
      {T("Works offline")}
    </li>
    <li>
      <Icon name="check" />
      {T("No sign-up")}
    </li>
    <li>
      <Icon name="check" />
      {T("No watermark")}
    </li>
  </ul>
  <p class="safe-oss">
    <Icon name="github" />
    <span>
      {T("Open source, so anyone can check how it works.")}{" "}
      <a href={CONTACT.source} rel="noopener" target="_blank">
        {T("See the code on GitHub")}
      </a>
    </span>
  </p>
</div>
