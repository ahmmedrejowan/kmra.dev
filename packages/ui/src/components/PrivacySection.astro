---
import Icon from "./Icon.astro";
import { pageLocale } from "../lib/locale";
import { t as tr } from "../lib/i18n";

const locale = pageLocale(Astro);
const T = (s: string) => tr(locale, s);
---

<div class="safe">
  <div class="safe-head">
    <span class="tile">
      <Icon name="shield" />
    </span>
    <div>
      <h2>{T("Your files never leave your device")}</h2>
      <p>{T("Everything runs in your browser.")}</p>
    </div>
  </div>
  <ul>
    <li>
      <Icon name="check" />
      {T("Runs on your device")}
    </li>
    <li>
      <Icon name="check" />
      {T("Works offline")}
    </li>
    <li>
      <Icon name="check" />
      {T("No sign-up")}
    </li>
    <li>
      <Icon name="check" />
      {T("No watermark")}
    </li>
  </ul>
</div>
