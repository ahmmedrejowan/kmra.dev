---
import { apps, getApp, linkTo, type AppId } from "@kmra/registry";
import Wordmark from "./Wordmark.astro";

interface Props {
  appId: AppId;
}

const { appId } = Astro.props;
const app = getApp(appId);
const dev = import.meta.env.DEV;
// Only apps that are live are listed; others appear once they launch.
const liveApps = apps.filter((a) => a.live);
const year = new Date().getFullYear();
const readyTools = app.tools.filter((t) => t.ready);
const toolList = readyTools.length ? readyTools : app.tools;
---

<footer class="site">
  <div class="wrap">
    <div class="fgrid">
      <div class="fbrand">
        <a href="/" aria-label={`${app.brand.join("")} home`}>
          <Wordmark appId={appId} />
        </a>
        <p>
          Small tools for everyday files. Everything runs in your browser, so
          your files stay on your device.
        </p>
      </div>
      <div>
        <strong>Tools</strong>
        <ul>
          {toolList.map((t) => (
            <li>
              <a href={`/${t.slug}`}>{t.name}</a>
            </li>
          ))}
        </ul>
      </div>
      <div>
        <strong>{app.tasks.length ? "Use cases" : "Apps"}</strong>
        <ul>
          {app.tasks.length
            ? app.tasks.slice(0, 7).map((t) => (
                <li>
                  <a href={`/${t.slug}`}>{t.name}</a>
                </li>
              ))
            : liveApps.map((a) => (
                <li>
                  <a href={linkTo(appId, a.id as AppId, "/", dev)}>{a.name}</a>
                </li>
              ))}
        </ul>
      </div>
      <div>
        <strong>kmra apps</strong>
        <ul>
          {liveApps.map((a) => (
            <li>
              <a href={linkTo(appId, a.id as AppId, "/", dev)}>
                {a.brand.join("")}
                <small class="fhost">{a.id}.kmra.dev</small>
              </a>
            </li>
          ))}
        </ul>
      </div>
      <div>
        <strong>Company</strong>
        <ul>
          <li>
            <a href="/about">About</a>
          </li>
          <li>
            <a href="/how-it-works">How it works</a>
          </li>
          <li>
            <a href="/privacy">Privacy</a>
          </li>
        </ul>
      </div>
    </div>
    <div class="fbottom">
      <span>© {year} kmra.dev</span>
      <span>Files are processed on your device and never uploaded.</span>
    </div>
  </div>
</footer>
