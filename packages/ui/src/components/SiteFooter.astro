---
import { apps, getApp, linkTo, type AppId } from "@kmra/registry";

interface Props {
  appId: AppId;
}

const { appId } = Astro.props;
const app = getApp(appId);
const dev = import.meta.env.DEV;
const year = new Date().getFullYear();
const readyTools = app.tools.filter((t) => t.ready);
const toolList = readyTools.length ? readyTools : app.tools;
const otherLive = apps.filter((a) => a.live && a.id !== appId);
---

<footer class="site">
  <div class="wrap">
    <div class="fgrid">
      <div>
        <strong>kmra</strong>
        <span class="muted">
          Small tools for everyday files. Everything runs in your browser, so
          your files stay on your device.
        </span>
      </div>
      <div>
        <strong>{app.name}</strong>
        <ul>
          {toolList.map((t) => (
            <li>
              <a href={`/${t.slug}`}>{t.name}</a>
            </li>
          ))}
        </ul>
      </div>
      {app.tasks.length > 0 ? (
        <div>
          <strong>Use cases</strong>
          <ul>
            {app.tasks.slice(0, 6).map((t) => (
              <li>
                <a href={`/${t.slug}`}>{t.name}</a>
              </li>
            ))}
          </ul>
        </div>
      ) : (
        otherLive.map((a) => (
          <div>
            <strong>{a.name}</strong>
            <ul>
              {a.tools
                .filter((t) => t.ready)
                .slice(0, 6)
                .map((t) => (
                  <li>
                    <a href={linkTo(appId, a.id as AppId, `/${t.slug}`, dev)}>
                      {t.name}
                    </a>
                  </li>
                ))}
            </ul>
          </div>
        ))
      )}
      <div>
        <strong>Apps</strong>
        <ul>
          {apps.map((a) => (
            <li>
              {a.live ? (
                <a href={linkTo(appId, a.id as AppId, "/", dev)}>{a.name}</a>
              ) : (
                <span>
                  {a.name} <span class="soon">Soon</span>
                </span>
              )}
            </li>
          ))}
        </ul>
      </div>
      <div>
        <strong>About</strong>
        <ul>
          <li>
            <a href="/how-it-works">How it works</a>
          </li>
          <li>
            <a href="/how-it-works#privacy">Privacy</a>
          </li>
        </ul>
      </div>
    </div>
    <p class="fbottom">
      © {year} kmra.dev. Files are processed on your device and never uploaded.
    </p>
  </div>
</footer>
