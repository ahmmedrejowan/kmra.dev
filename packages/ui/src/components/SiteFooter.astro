---
import { apps, CONTACT, getApp, linkTo, type AppId } from "@kmra/registry";
import Wordmark from "./Wordmark.astro";
import { markSvg } from "../lib/brand";

interface Props {
  appId: AppId;
}

const { appId } = Astro.props;
const app = getApp(appId);
const dev = import.meta.env.DEV;
// Only apps that are live are listed; others appear once they launch.
const liveApps = apps.filter((a) => a.live);
const year = new Date().getFullYear();
const readyTools = app.tools.filter((t) => t.ready);
const toolList = readyTools.length ? readyTools : app.tools;
---

<footer class="site">
  <div class="wrap">
    <div class="fgrid">
      <div class="fbrand">
        <a href="/" aria-label={`${app.brand.join("")} home`}>
          <Wordmark appId={appId} />
        </a>
        <p>
          Small tools for everyday files. Everything runs in your browser, so
          your files stay on your device.
        </p>
        <a class="fmail" href={`mailto:${CONTACT.email}`}>
          {CONTACT.email}
        </a>
      </div>
      <div>
        <strong>Tools</strong>
        <ul>
          {toolList.map((t) => (
            <li>
              <a href={`/${t.slug}`}>{t.name}</a>
            </li>
          ))}
        </ul>
      </div>
      {app.tasks.length > 0 && (
        <div>
          <strong>Use cases</strong>
          <ul>
            {app.tasks.slice(0, 7).map((t) => (
              <li>
                <a href={`/${t.slug}`}>{t.name}</a>
              </li>
            ))}
          </ul>
        </div>
      )}
      <div>
        <strong>kmra apps</strong>
        <ul class="fapps">
          {liveApps.map((a) => (
            <li>
              <a
                href={linkTo(appId, a.id as AppId, "/", dev)}
                aria-current={a.id === appId ? "true" : undefined}
                style={`--app:${a.accent.light}`}
              >
                <span
                  class="fapp-mark"
                  set:html={markSvg(a.id, a.accent.light)}
                  aria-hidden="true"
                />
                <span>
                  <span
                    class="fapp-name"
                    set:html={`<span style="color:var(--app)">${a.brand[0]}</span>${a.brand[1]}`}
                  />
                  <small>{a.id}.kmra.dev</small>
                </span>
              </a>
            </li>
          ))}
        </ul>
      </div>
      <div>
        <strong>About</strong>
        <ul>
          <li>
            <a href="/about">About {app.brand.join("")}</a>
          </li>
          <li>
            <a href="/how-it-works">How it works</a>
          </li>
          <li>
            <a href="/privacy">Privacy</a>
          </li>
          <li>
            <a href={`mailto:${CONTACT.email}`}>Contact</a>
          </li>
          <li>
            <a href="#shortcuts" data-shortcuts>
              Keyboard shortcuts
            </a>
          </li>
          <li>
            <a href="/sitemap">Sitemap</a>
          </li>
          <li>
            <a href={CONTACT.portfolio} rel="noopener" target="_blank">
              rejowan.com
            </a>
          </li>
          <li>
            <a href={CONTACT.linkedin} rel="noopener" target="_blank">
              LinkedIn
            </a>
          </li>
        </ul>
      </div>
    </div>
    <div class="fbottom">
      <span>© {year} kmra.dev</span>
      <span>
        Made by{" "}
        <a href={CONTACT.portfolio} rel="noopener" target="_blank">
          {CONTACT.maker}
        </a>
      </span>
    </div>
  </div>
</footer>
