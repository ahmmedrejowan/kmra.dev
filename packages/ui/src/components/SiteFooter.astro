---
import {
  CONTACT,
  getApp,
  HUB,
  issueUrl,
  localizeApp,
  type AppId,
} from "@kmra/registry";
import Wordmark from "./Wordmark.astro";
import Icon from "./Icon.astro";
import { markSvg } from "../lib/brand";
import { appLink, hubLink, langLinks, pageLocale } from "../lib/locale";
import { footerApps } from "../lib/related";
import { lp, t as tr } from "../lib/i18n";

interface Props {
  appId: AppId;
}

const { appId } = Astro.props;
const locale = pageLocale(Astro);
const T = (s: string, v?: Record<string, string | number>) => tr(locale, s, v);
const L = (p: string) => lp(locale, p);
const app = localizeApp(getApp(appId), locale);
const langs = langLinks(Astro, app);
const dev = import.meta.env.DEV;
const year = new Date().getFullYear();
const readyTools = app.tools.filter((t) => t.ready);
// Popular tools first, then the rest, seven in all; the sitemap page has everything
const popular = app.popular ?? [];
const toolList = (readyTools.length ? readyTools : app.tools)
  .slice()
  .sort(
    (a, b) =>
      (popular.includes(a.slug) ? popular.indexOf(a.slug) : 99) -
      (popular.includes(b.slug) ? popular.indexOf(b.slug) : 99),
  )
  .slice(0, 5);
// Five use cases (popular ones first) and a link to all of them: six lines per column
const taskList = app.tasks
  .slice()
  .sort(
    (a, b) =>
      (popular.includes(a.slug) ? popular.indexOf(a.slug) : 99) -
      (popular.includes(b.slug) ? popular.indexOf(b.slug) : 99),
  )
  .slice(0, 5);
---

<footer class="site">
  <div class="wrap">
    <div class="fgrid">
      <div class="fbrand">
        <span class="logo-wrap">
          <a
            href={L("/")}
            aria-label={T("{brand} home", { brand: app.brand.join("") })}
          >
            <Wordmark appId={appId} dom={false} />
          </a>
          {HUB.live ? (
            <a
              class="wm-dom"
              href={hubLink(locale, "/", dev)}
              title={T("Every app on kmra.dev")}
            >
              kmra.dev
            </a>
          ) : (
            <span class="wm-dom">kmra.dev</span>
          )}
        </span>
        <p>
          {app.listens
            ? T(
                "Small, private tools. Everything runs in your browser, so what you play and type stays on your device.",
              )
            : app.noFiles
              ? T(
                  "Small, private tools. Everything runs in your browser, so what you type stays on your device.",
                )
              : T(
                  "Small tools for everyday files. Everything runs in your browser, so your files stay on your device.",
                )}
        </p>
        <a class="fmail" href={`mailto:${CONTACT.email}`}>
          {CONTACT.email}
        </a>
      </div>
      <div>
        <strong>{T("Tools")}</strong>
        <ul>
          {toolList.map((t) => (
            <li>
              <a href={L(`/${t.slug}`)}>{t.name}</a>
            </li>
          ))}
          {readyTools.length > toolList.length && (
            <li>
              <a class="fmore" href={L("/tools")}>
                {T("All {n} tools", { n: readyTools.length })}
              </a>
            </li>
          )}
        </ul>
      </div>
      {app.tasks.length > 0 && (
        <div>
          <strong>{T("Use cases")}</strong>
          <ul>
            {taskList.map((t) => (
              <li>
                <a href={L(`/${t.slug}`)}>{t.name}</a>
              </li>
            ))}
            {app.tasks.length > taskList.length && (
              <li>
                <a class="fmore" href={L("/use-cases")}>
                  {T("All {n} use cases", { n: app.tasks.length })}
                </a>
              </li>
            )}
          </ul>
        </div>
      )}
      <div>
        <strong>{T("kmra apps")}</strong>
        <ul class="fapps">
          {footerApps(appId).map((a) => (
            <li>
              <a
                href={appLink(appId, locale, a.id as AppId, "/", dev)}
                style={`--app:${a.accent.light};--app-d:${a.accent.dark}`}
              >
                <span
                  class="fapp-mark"
                  set:html={markSvg(a.id, a.accent.light)}
                  aria-hidden="true"
                />
                <span
                  class="fapp-name"
                  set:html={`<span class="app-fg">${a.brand[0]}</span>${a.brand[1]}`}
                />
              </a>
            </li>
          ))}
          <li>
            <a class="fmore" href={L("/more-tools")}>
              {T("See all kmra tools")}
            </a>
          </li>
        </ul>
      </div>
      <div>
        <strong>{T("About")}</strong>
        <ul>
          <li>
            <a href={L("/about")}>
              {T("About {brand}", { brand: app.brand.join("") })}
            </a>
          </li>
          <li>
            <a href={L("/how-it-works")}>{T("How it works")}</a>
          </li>
          <li>
            <a href={L("/privacy")}>{T("Privacy")}</a>
          </li>
          <li>
            <a href={`mailto:${CONTACT.email}`}>{T("Contact")}</a>
          </li>
          <li>
            <a href="#shortcuts" data-shortcuts>
              {T("Keyboard shortcuts")}
            </a>
          </li>
          <li>
            <a href={CONTACT.source} rel="noopener" target="_blank">
              {T("Source code")}
            </a>
          </li>
        </ul>
      </div>
    </div>
    <div class="fbottom">
      <span>
        © {year}{" "}
        {HUB.live ? (
          <a href={hubLink(locale, "/", dev)}>kmra.dev</a>
        ) : (
          "kmra.dev"
        )}
        {" · "}
        <a href={CONTACT.source} rel="noopener" target="_blank">
          {T("Open source")}
        </a>
        {" · "}
        <a href={issueUrl("bug")} rel="noopener" target="_blank">
          {T("Report a problem")}
        </a>
        {" · "}
        <a href={issueUrl("idea")} rel="noopener" target="_blank">
          {T("Suggest a tool")}
        </a>
      </span>
      {langs.length > 1 && (
        <nav class="flangs" aria-label={T("Language")}>
          <Icon name="languages" />
          {langs.map((l) => (
            <a
              href={l.href}
              hreflang={l.code}
              lang={l.code}
              aria-current={l.current ? "true" : undefined}
            >
              {l.native}
            </a>
          ))}
        </nav>
      )}
      <span>
        {T("Made by")}{" "}
        <a href={CONTACT.portfolio} rel="noopener" target="_blank">
          {CONTACT.maker}
        </a>
      </span>
    </div>
  </div>
</footer>
