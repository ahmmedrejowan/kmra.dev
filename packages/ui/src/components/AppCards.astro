---
import { apps, localizeApp, type AppId } from "@kmra/registry";
import Icon from "./Icon.astro";
import { markSvg } from "../lib/brand";
import { appLink, pageLocale } from "../lib/locale";

interface Props {
  appId: AppId;
  /** Leave out the current app */
  others?: boolean;
}

const { appId, others = false } = Astro.props;
const dev = import.meta.env.DEV;
const locale = pageLocale(Astro);
const list = apps
  .filter((a) => a.live && (!others || a.id !== appId))
  .map((a) => localizeApp(a, locale));
---

<div class="apps">
  {list.map((a) => {
    const style = `--app:${a.accent.light}`;
    const body = (
      <>
        <span
          class="app-mark"
          set:html={markSvg(a.id, a.accent.light)}
          aria-hidden="true"
        />
        <span class="app-text">
          <strong>
            <span
              set:html={`<span style="color:var(--app)">${a.brand[0]}</span>${a.brand[1]}`}
            />
            {!a.live && <span class="soon">Soon</span>}
          </strong>
          <small>{a.tagline}</small>
          <span class="app-host">{a.id}.kmra.dev</span>
        </span>
        {a.live && <Icon name="right" class="ico go" />}
      </>
    );
    return a.live ? (
      <a
        class="appcard live"
        href={appLink(appId, locale, a.id as AppId, "/", dev)}
        style={style}
      >
        {body}
      </a>
    ) : (
      <div class="appcard" style={style}>
        {body}
      </div>
    );
  })}
</div>
