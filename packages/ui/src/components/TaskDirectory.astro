---
import { groupBy, type IconName, type Task } from "@kmra/registry";
import Icon from "./Icon.astro";

interface Props {
  tasks: readonly Task[];
  icons: Record<string, IconName>;
}

const { tasks, icons } = Astro.props;
const groups = groupBy(tasks);
---

<div class="dir-cols">
  {groups.map(([group, list]) => (
    <section class="dir-panel">
      <header>
        <span class="tile">
          <Icon name={icons[list[0]!.tool] ?? "file"} />
        </span>
        <h3>{group}</h3>
        <small>{list.length}</small>
      </header>
      <ul>
        {list.map((t) => (
          <li>
            <a href={`/${t.slug}`}>
              <span>
                <strong>{t.name}</strong>
                <small>{t.short}</small>
              </span>
              <Icon name="right" class="ico go" />
            </a>
          </li>
        ))}
      </ul>
    </section>
  ))}
</div>
