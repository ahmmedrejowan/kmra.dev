---
import { groupBy, type IconName, type Task } from "@kmra/registry";
import Icon from "./Icon.astro";
import { pageLocale } from "../lib/locale";
import { lp, num, t as tr } from "../lib/i18n";

interface Props {
  tasks: readonly Task[];
  icons: Record<string, IconName>;
}

const { tasks, icons } = Astro.props;
const groups = groupBy(tasks);
const locale = pageLocale(Astro);
const L = (p: string) => lp(locale, p);
// Panels show six each so they line up; the rest open in place
const SHOW = 6;
---

<div class="dir-cols">
  {groups.map(([group, list]) => (
    <section class="dir-panel">
      <header>
        <span class="tile">
          <Icon name={icons[list[0]!.tool] ?? "file"} />
        </span>
        <h3>{group}</h3>
        <small>{num(locale, list.length)}</small>
      </header>
      <ul>
        {list.slice(0, SHOW).map((t) => (
          <li>
            <a href={L(`/${t.slug}`)}>
              <span>
                <strong>{t.name}</strong>
                <small>{t.short}</small>
              </span>
              <Icon name="right" class="ico go" />
            </a>
          </li>
        ))}
      </ul>
      {list.length > SHOW && (
        <details class="dir-more">
          <summary>{tr(locale, "{n} more", { n: list.length - SHOW })}</summary>
          <ul>
            {list.slice(SHOW).map((t) => (
              <li>
                <a href={L(`/${t.slug}`)}>
                  <span>
                    <strong>{t.name}</strong>
                    <small>{t.short}</small>
                  </span>
                  <Icon name="right" class="ico go" />
                </a>
              </li>
            ))}
          </ul>
        </details>
      )}
    </section>
  ))}
</div>
