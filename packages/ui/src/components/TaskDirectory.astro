---
import { groupBy, type IconName, type Task } from "@kmra/registry";
import Icon from "./Icon.astro";

interface Props {
  tasks: readonly Task[];
  icons: Record<string, IconName>;
  title: string;
  intro: string;
}

const { tasks, icons, title, intro } = Astro.props;
const groups = groupBy(tasks);
---

<section class="band-soft">
  <div class="wrap dir">
    <div class="dir-head">
      <h2>{title}</h2>
      <p>{intro}</p>
    </div>
    <div class="dir-cols">
      {groups.map(([group, list]) => (
        <div>
          <h3>{group}</h3>
          <ul>
            {list.map((t) => (
              <li>
                <a href={`/${t.slug}`}>
                  <Icon name={icons[t.tool] ?? "file"} />
                  <span>
                    <strong>{t.name}</strong>
                    <small>{t.short}</small>
                  </span>
                  <Icon name="right" class="ico go" />
                </a>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>
  </div>
</section>
