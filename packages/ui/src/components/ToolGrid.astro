---
import type { Tool } from "@kmra/registry";

interface Props {
  tools: readonly Tool[];
  /** Slug to leave out, e.g. the current tool on a tool page */
  exclude?: string;
}

const { tools, exclude } = Astro.props;
const list = tools.filter((t) => t.slug !== exclude);
---

<ul class="grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
  {list.map((tool) => (
    <li>
      <a
        href={`/${tool.slug}`}
        class="block h-full rounded-lg border border-border bg-surface p-4 transition hover:border-accent"
      >
        <div class="flex items-center justify-between gap-2">
          <span class="font-medium">{tool.name}</span>
          {!tool.ready && <span class="text-xs text-muted">Soon</span>}
        </div>
        <p class="mt-1 text-sm text-muted">{tool.description}</p>
      </a>
    </li>
  ))}
</ul>
