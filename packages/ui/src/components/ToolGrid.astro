---
import type { Tool } from "@kmra/registry";
import Icon from "./Icon.astro";

interface Props {
  tools: readonly Tool[];
}

const { tools } = Astro.props;
---

<div class="tgrid">
  {tools.map((t) => (
    <a class="tcard" href={`/${t.slug}`}>
      <span class="tile">
        <Icon name={t.icon} />
      </span>
      <strong>
        {t.name}
        {!t.ready && <span class="soon">Soon</span>}
      </strong>
      <p>{t.description}</p>
    </a>
  ))}
</div>
