---
import { CONTACT, issueUrl } from "@kmra/registry";
import Icon from "./Icon.astro";
import { pageLocale } from "../lib/locale";
import { num, t as tr } from "../lib/i18n";

interface Props {
  steps: readonly string[];
  items: readonly { q: string; a: string }[];
}

const { steps, items } = Astro.props;
const locale = pageLocale(Astro);
// The bug form opens with this page's address filled in
// (the build writes /compress.html; the live address is /compress)
const path = Astro.url.pathname.replace(/\.html$/, "").replace(/\/index$/, "/");
const page = new URL(path, Astro.site ?? Astro.url).href;
---

<section
  class="infocard"
  aria-label={tr(locale, "How it works and common questions")}
>
  <ol class="info-steps">
    {steps.map((s, i) => (
      <li>
        <b>{num(locale, i + 1)}</b>
        <span>{s}</span>
      </li>
    ))}
  </ol>
  <dl class="info-qa">
    {items.map((it) => (
      <div>
        <dt>{it.q}</dt>
        <dd>{it.a}</dd>
      </div>
    ))}
  </dl>
  <p class="info-report">
    <Icon name="github" />
    <span>
      {tr(locale, "Something not working, or a tool you'd like?")}{" "}
      <a href={issueUrl("bug", page)} rel="noopener" target="_blank">
        {tr(locale, "Report a problem")}
      </a>
      {" · "}
      <a href={issueUrl("idea")} rel="noopener" target="_blank">
        {tr(locale, "Suggest a tool")}
      </a>
      {" · "}
      <a href={CONTACT.source} rel="noopener" target="_blank">
        {tr(locale, "Open source on GitHub")}
      </a>
    </span>
  </p>
</section>
