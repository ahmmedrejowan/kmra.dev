---
import type { Tool } from "@kmra/registry";

interface Props {
  tools: readonly Tool[];
  /** Slug to leave out, e.g. the current tool on a tool page */
  exclude?: string;
}

const { tools, exclude } = Astro.props;
const list = tools.filter((t) => t.slug !== exclude);
---

<ul class="divide-y divide-line border-y border-line">
  {list.map((tool) => (
    <li>
      <a
        href={`/${tool.slug}`}
        class="group grid gap-1 py-5 sm:grid-cols-[14rem_1fr_auto] sm:items-baseline sm:gap-6"
      >
        <span class="font-wide text-lg font-bold tracking-tight group-hover:underline group-hover:decoration-marker group-hover:decoration-2 group-hover:underline-offset-4">
          {tool.name}
        </span>
        <span class="text-muted">{tool.description}</span>
        <span
          class:list={["text-sm", tool.ready ? "font-medium" : "text-muted"]}
        >
          {tool.ready ? "Open" : "Coming soon"}
        </span>
      </a>
    </li>
  ))}
</ul>
