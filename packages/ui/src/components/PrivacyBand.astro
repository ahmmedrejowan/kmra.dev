---
import Icon from "./Icon.astro";

interface Props {
  /** Example file name shown in the network panel */
  file: string;
  /** First row in the network panel: the page itself */
  page: string;
  /** Worker or engine file the tool loads */
  engine?: string;
}

const { file, page, engine = "engine.worker.js" } = Astro.props;
---

<section class="privacy">
  <div class="wrap privacy-in">
    <div>
      <h2>Your files never leave your device.</h2>
      <p class="privacy-lede">
        Most online tools upload your file, process it on their server and send
        it back. kmra sends the tool to your browser instead, and the site is
        blocked from contacting any other server.
      </p>
      <ul class="privacy-points">
        <li>
          <Icon name="shield" />
          <span>
            <strong>Private by design.</strong> Nothing to leak, because nothing
            is sent.
          </span>
        </li>
        <li>
          <Icon name="zap" />
          <span>
            <strong>No waiting.</strong> No upload or download step, so most
            files are done in under a second.
          </span>
        </li>
        <li>
          <Icon name="offline" />
          <span>
            <strong>Works offline.</strong> Once a tool has loaded, it doesn't
            need a connection.
          </span>
        </li>
      </ul>
      <a class="btn lg privacy-cta" href="/how-it-works">
        See how it works
      </a>
    </div>

    <div
      class="netpanel"
      aria-label="Example of the browser's Network tab while using kmra"
    >
      <div class="np-bar">
        <span class="dots" aria-hidden="true">
          <i></i>
          <i></i>
          <i></i>
        </span>
        Network
        <span class="soon">Example</span>
      </div>
      <table>
        <thead>
          <tr>
            <th>Name</th>
            <th>Status</th>
            <th>Size</th>
          </tr>
        </thead>
        <tbody>
          <tr>
            <td>{page}</td>
            <td>200</td>
            <td>9 KB</td>
          </tr>
          <tr>
            <td>app.js</td>
            <td>200</td>
            <td>48 KB</td>
          </tr>
          <tr>
            <td>{engine}</td>
            <td>200</td>
            <td>6 KB</td>
          </tr>
          <tr>
            <td>geist.woff2</td>
            <td>200</td>
            <td>28 KB</td>
          </tr>
        </tbody>
      </table>
      <div class="np-file">
        <Icon name="check" />
        <span>
          <strong>{file}</strong> processed on this device
        </span>
        <b>0 B sent</b>
      </div>
    </div>
  </div>
</section>
