---
import { apps, getApp, groupBy, localizeApp, type AppId } from "@kmra/registry";
import { appLink, pageLocale } from "../lib/locale";
import { lp, t as tr } from "../lib/i18n";

interface Props {
  appId: AppId;
  /** Extra pages specific to this app, e.g. the image editor (English labels) */
  extra?: readonly { href: string; label: string }[];
}

const { appId, extra = [] } = Astro.props;
const dev = import.meta.env.DEV;
const locale = pageLocale(Astro);
const T = (s: string, v?: Record<string, string | number>) => tr(locale, s, v);
const L = (p: string) => lp(locale, p);
const app = localizeApp(getApp(appId), locale);
const others = apps
  .filter((a) => a.live && a.id !== appId)
  .map((a) => localizeApp(a, locale));
const pages = [
  { href: "/", label: "Home" },
  ...extra,
  { href: "/how-it-works", label: "How it works" },
  { href: "/privacy", label: "Privacy" },
  { href: "/about", label: "About" },
];
const tools = app.tools.filter((t) => t.ready);
const toolGroups = groupBy(tools, app.toolGroups);
---

<div class="smap">
  <section>
    <h2>{T("Pages")}</h2>
    <ul>
      {pages.map((p) => (
        <li>
          <a href={L(p.href)}>{T(p.label)}</a>
        </li>
      ))}
    </ul>
  </section>
  {toolGroups.map(([group, list]) => (
    <section>
      <h2>
        {toolGroups.length > 1 ? T("Tools: {group}", { group }) : T("Tools")}
      </h2>
      <ul>
        {list.map((t) => (
          <li>
            <a href={L(`/${t.slug}`)}>{t.title ?? t.name}</a>
          </li>
        ))}
      </ul>
    </section>
  ))}
  {app.tasks.length > 0 && (
    <section id="use-cases">
      <h2>{T("Use cases")}</h2>
      <ul>
        {app.tasks.map((t) => (
          <li>
            <a href={L(`/${t.slug}`)}>{t.title}</a>
          </li>
        ))}
      </ul>
    </section>
  )}
  <section>
    <h2>{T("Other kmra apps")}</h2>
    <ul>
      {others.map((a) => (
        <li>
          <a href={appLink(appId, locale, a.id as AppId, "/", dev)}>{a.name}</a>
        </li>
      ))}
    </ul>
    <p class="muted">
      {T("For search engines:")} <a href="/sitemap.xml">{T("XML sitemap")}</a>
    </p>
  </section>
</div>
