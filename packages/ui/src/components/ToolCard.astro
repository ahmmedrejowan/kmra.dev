---
import type { Accent, Tool } from "@kmra/registry";
import Icon from "./Icon.astro";
import { pageLocale } from "../lib/locale";
import { lp, t as tr } from "../lib/i18n";

interface Props {
  tool: Tool;
  /** Duplicate copy in a scrolling row: hidden from assistive tech and keyboard */
  hidden?: boolean;
  /** A tool of another app (the kmra.dev hub): its app, full link and colour */
  appId?: string;
  href?: string;
  accent?: Accent;
}

const { tool, hidden = false, appId, href, accent } = Astro.props;
const locale = pageLocale(Astro);
const T = (s: string) => tr(locale, s);
// Each app is built with its own site URL (imgtool.kmra.dev, pdftool.kmra.dev, ...)
const app = appId ?? Astro.site?.hostname.split(".")[0] ?? "imgtool";
const hue = accent
  ? `--acc-l:${accent.light};--acc-d:${accent.dark};--acc-soft-l:${accent.softLight};--acc-soft-d:${accent.softDark}`
  : undefined;
const page = (lines = 3) => Array.from({ length: lines });
// AudioTool cards: a little waveform, shaped by what the tool does
const BARS = [
  0.35, 0.55, 0.8, 0.6, 0.95, 0.7, 0.5, 0.85, 0.65, 0.4, 0.75, 1, 0.6, 0.45,
  0.8, 0.55, 0.9, 0.7, 0.35, 0.6, 0.85, 0.5, 0.7, 0.95, 0.6, 0.4, 0.65, 0.3,
];
const bars = (() => {
  const n = BARS.length;
  const s = tool.slug;
  return BARS.map((h, i) => {
    let v = h;
    if (s === "fade") v *= Math.min(1, (i + 1) / 7, (n - i) / 7);
    else if (s === "normalize") v = 0.62 + (h - 0.6) * 0.15;
    else if (s === "volume") v = Math.min(1, h * 1.25);
    else if (s === "reverse") v = BARS[n - 1 - i]!;
    else if (s === "remove-silence" && ((i >= 8 && i <= 11) || (i >= 19 && i <= 21)))
      v = 0.04;
    else if (s === "mono") v = h * 0.8;
    return {
      h: Math.round(Math.max(0.04, v) * 100),
      on: s === "trim" ? i >= 9 && i <= 19 : s !== "remove-silence" || v > 0.05,
    };
  });
})();
// CalcTool cards: a little display with a typical sum and its answer
const CALC: Record<string, [string, string]> = {
  calculator: ["(12 + 8) × 4", "80"],
  percentage: ["15% of 80", "12"],
  discount: ["80 − 25%", "60"],
  tip: ["92 + 15% ÷ 5", "21.16"],
  "sales-tax": ["100 + 20% VAT", "120"],
  fraction: ["1/3 + 1/4", "7/12"],
  "aspect-ratio": ["1920 × 1080", "16:9"],
  loan: ["100,000 · 5% · 30 y", "536.82/mo"],
  "compound-interest": ["10,000 · 5% · 10 y", "16,289"],
  salary: ["25/h · 40 h", "52,000/yr"],
  age: ["12 Mar 1990", "36 y 6 m"],
  "date-difference": ["1 Jan – 1 Apr", "91 days"],
  "time-calculator": ["2:45 + 1:30", "4:15"],
  "time-zones": ["New York 9:00", "London 14:00"],
  bmi: ["70 kg · 175 cm", "22.9"],
  calories: ["Moderately active", "2,350 kcal"],
  "unit-converter": ["1 inch", "2.54 cm"],
};
// ColorTool cards: the colours themselves
const SWATCHES = ["#ff6b6b", "#ffb347", "#ffe066", "#4ecdc4", "#556cd6"];
const SCALE = ["#fdf3df", "#fbe2b4", "#f7cc7e", "#f2b53c", "#e19a12", "#c27a00", "#9c5f05", "#7b4a0a", "#5f390c", "#3f2507", "#241503"];
const AUDIO_FORMATS: Record<string, [string[], string[]]> = {
  convert: [["WAV", "FLAC"], ["MP3", "M4A"]],
  "video-to-audio": [["MP4", "MOV"], ["MP3"]],
  compress: [["WAV"], ["MP3"]],
};
// A few lines of code per developer tool card
const SNIPS: Record<string, string[]> = {
  "json-formatter": ["{", '  "name": "kmra",', '  "live": true', "}"],
  "yaml-json": ["name: kmra", "live: true", '→ {"name":"kmra"}'],
  "xml-formatter": ["<site>", "  <name>kmra</name>", "</site>"],
  "sql-formatter": ["SELECT id, name", "FROM tools", "WHERE live = 1"],
  "html-formatter": ["<main>", "  <h1>Hi</h1>", "</main>"],
  "css-formatter": [".card {", "  color: #8e4ec6;", "}"],
  "js-formatter": ["const ok = (x) =>", "  x > 0;"],
  "markdown-preview": ["# Title", "**bold** text", "- item"],
  base64: ["héllo 👋", "aMOpbGxvIPCfkYs="],
  "url-encode": ["a b&c", "a%20b%26c"],
  "html-entities": ['<a href="#">', "&lt;a href=&quot;#&quot;&gt;"],
  "jwt-decoder": ["eyJhbGciOiJIUzI1…", '{ "sub": "42" }', "expires in 2 h"],
  "unicode-escape": ["é → \\u00e9", "👋 → \\u{1F44B}"],
  "text-hex": ["Hi", "48 69", "01001000 01101001"],
  uuid: ["018f3a2c-7b1d-7c4e-", "9a1b-5f2e8c0d4a17"],
  "password-generator": ["k7#Qv!2pRz$9", "strong, 78 bits"],
  hash: ["SHA-256", "ba7816bf8f01cfea…"],
  "lorem-ipsum": [
    "Lorem ipsum dolor",
    "sit amet, consec-",
    "tetur adipiscing.",
  ],
  "fake-data": ["name,email", "Ada,ada@mail.dev", "Lin,lin@mail.dev"],
  timestamp: ["1700000000", "2023-11-14 22:13 UTC"],
  "number-base": ["255", "0xff  0b11111111"],
  "color-converter": ["#8e4ec6", "rgb(142 78 198)"],
  "case-converter": ["userId", "user_id  UserId"],
  "csv-json": ["id,name", "1,Ada", '→ [{"id":1,…}]'],
  "json-to-typescript": ["interface User {", "  id: number;", "}"],
  "curl-converter": ["curl -X POST …", "→ fetch(url, {…})"],
  "diff-checker": ["- old line", "+ new line"],
  "regex-tester": ["/\\d{3}-\\d{4}/g", "2 matches"],
  "line-tools": ["b, a, a", "→ a, b"],
  "slug-generator": ["Hello World!", "hello-world"],
  "cron-explainer": ["*/15 9-17 * * 1-5", "every 15 min, weekdays"],
  "chmod-calculator": ["755", "rwxr-xr-x"],
  "url-parser": ["https://kmra.dev/a?b=1", "host  path  query"],
  "http-status": ["404", "Not Found"],
};
// Small QR mark reused by the QR tool cards
const QR = `<svg viewBox="0 0 21 21"><path fill="currentColor" fill-rule="evenodd" d="M0 0h7v7H0zM1 1v5h5V1zM2 2h3v3H2zM14 0h7v7h-7zM15 1v5h5V1zM16 2h3v3h-3zM0 14h7v7H0zM1 15v5h5v-5zM2 16h3v3H2zM9 1h2v2H9zM9 5h1v3H9zM12 9h3v1h-3zM9 9h2v2H9zM17 9h3v2h-3zM9 13h3v2H9zM14 14h2v3h-2zM18 16h3v2h-3zM10 18h3v3h-3zM16 19h2v2h-2zM1 9h3v2H1zM5 10h2v1H5z"/></svg>`;
// A 14×14 Data Matrix look: solid L finder (left, bottom), dotted clock track (top, right)
const dm = (() => {
  const n = 14;
  let d = "";
  for (let y = 0; y < n; y++)
    for (let x = 0; x < n; x++) {
      const on =
        x === 0 ||
        y === n - 1 ||
        (y === 0 && x % 2 === 0) ||
        (x === n - 1 && y % 2 === 1) ||
        (x > 0 &&
          y > 0 &&
          x < n - 1 &&
          y < n - 1 &&
          (x * 7 + y * 13 + x * y) % 5 < 2);
      if (on) d += `M${x} ${y}h1v1h-1z`;
    }
  return `<svg viewBox="0 0 ${n} ${n}" shape-rendering="crispEdges"><path fill="currentColor" d="${d}"/></svg>`;
})();
---

<a
  class:list={["feat", { hue: !!accent }]}
  style={hue}
  href={href ?? lp(locale, `/${tool.slug}`)}
  aria-hidden={hidden ? "true" : undefined}
  tabindex={hidden ? -1 : undefined}
>
  <div class="feat-art" aria-hidden="true">
    {app === "musictool" ? (
      <div class:list={["art-mus", tool.slug]} aria-hidden="true">
        {tool.slug === "tuner" ? (
          <span class="art-mus-tuner">
            <svg viewBox="0 0 120 64">
              <path d="M10 60a50 50 0 0 1 100 0" fill="none" stroke="currentColor" stroke-opacity=".25" stroke-width="6" stroke-linecap="round" />
              <path d="M52 12a50 50 0 0 1 16 0" fill="none" stroke="var(--acc)" stroke-width="6" stroke-linecap="round" />
              <path d="M60 60 61 16" stroke="var(--fg)" stroke-width="3" stroke-linecap="round" />
            </svg>
            <b>A4</b>
            <small>0¢ · in tune</small>
          </span>
        ) : tool.slug === "metronome" ? (
          <span class="art-mus-bpm">
            <b>120</b>
            <small>BPM</small>
            <span class="dots">
              <i class="on" />
              <i />
              <i />
              <i />
            </span>
          </span>
        ) : tool.slug === "tap-tempo" ? (
          <span class="art-mus-bpm">
            <b>96</b>
            <small>{T("taps per minute")}</small>
          </span>
        ) : tool.slug === "chords" ? (
          <span class="art-mus-chord">
            <svg viewBox="0 0 60 72">
              <path d="M8 10h44" stroke="var(--fg)" stroke-width="3" />
              {[0, 1, 2, 3, 4, 5].map((i) => (
                <path d={`M${8 + i * 8.8} 10v56`} stroke="currentColor" stroke-opacity=".35" stroke-width="1.4" />
              ))}
              {[1, 2, 3, 4].map((i) => (
                <path d={`M8 ${10 + i * 14}h44`} stroke="currentColor" stroke-opacity=".35" stroke-width="1.4" />
              ))}
              <circle cx="16.8" cy="45" r="4" fill="var(--acc)" />
              <circle cx="25.6" cy="31" r="4" fill="var(--acc)" />
              <circle cx="43.2" cy="17" r="4" fill="var(--acc)" />
            </svg>
            <b>C</b>
          </span>
        ) : tool.slug === "scales" ? (
          <span class="art-mus-keys">
            {[1, 0, 1, 0, 1, 1, 0, 1, 0, 1, 0, 1].map((w, i) =>
              w ? (
                <i class:list={{ on: [0, 2, 4, 7, 9].includes(i) }} />
              ) : null,
            )}
          </span>
        ) : tool.slug === "ear-trainer" ? (
          <span class="art-mus-ear">
            <span>{T("Major 3rd")}</span>
            <span class="on">{T("Perfect 5th")}</span>
            <span>{T("Octave")}</span>
          </span>
        ) : (
          <span class="art-mus-wave">
            <svg viewBox="0 0 160 60" preserveAspectRatio="none">
              <path
                d={
                  tool.slug === "drone"
                    ? "M0 30 C10 18 20 18 30 30 S50 42 60 30 S80 18 90 30 S110 42 120 30 S140 18 150 30 L160 30"
                    : "M0 30 C10 4 20 4 30 30 S50 56 60 30 S80 4 90 30 S110 56 120 30 S140 4 150 30 L160 30"
                }
                fill="none"
                stroke="var(--acc)"
                stroke-width="3"
              />
            </svg>
            <b>{tool.slug === "drone" ? "D · A" : "440 Hz"}</b>
          </span>
        )}
      </div>
    ) : null}
    {app === "calctool" && CALC[tool.slug] ? (
      <div class="art-calc" aria-hidden="true">
        <span class="art-calc-q">{CALC[tool.slug]![0]}</span>
        <span class="art-calc-a">{CALC[tool.slug]![1]}</span>
      </div>
    ) : null}
    {app === "colortool" ? (
      <div class:list={["art-col", tool.slug]} aria-hidden="true">
        {tool.slug === "color-picker" ? (
          <>
            <span class="art-col-sv" />
            <span class="art-col-hue" />
          </>
        ) : tool.slug === "color-mixer" ? (
          <>
            {["#ff7f6e", "#e58a96", "#c493bf", "#9b9ce0", "#6aa4f5"].map((c) => (
              <i style={`background:${c}`} />
            ))}
          </>
        ) : tool.slug === "palette-generator" ? (
          <>
            {SWATCHES.map((c) => (
              <i class="tall" style={`background:${c}`} />
            ))}
          </>
        ) : tool.slug === "shades" ? (
          <>
            {SCALE.map((c) => (
              <i class="thin" style={`background:${c}`} />
            ))}
          </>
        ) : tool.slug === "contrast-checker" ? (
          <span class="art-col-contrast">
            Aa<b>7.1:1</b>
          </span>
        ) : tool.slug === "color-blindness" ? (
          <span class="art-col-cvd">
            <span>
              {SWATCHES.map((c) => (
                <i style={`background:${c}`} />
              ))}
            </span>
            <span>
              {["#a39a6e", "#c9b45c", "#e8d968", "#9fb3cc", "#5d6fb0"].map((c) => (
                <i style={`background:${c}`} />
              ))}
            </span>
          </span>
        ) : tool.slug === "gradient-generator" ? (
          <span class="art-col-grad" />
        ) : (
          <span class="art-col-shadow" />
        )}
      </div>
    ) : null}
    {app === "colortool" || app === "calctool" || app === "musictool" ? null : app === "audiotool" && AUDIO_FORMATS[tool.slug] && tool.slug !== "compress" ? (
      <div class="art-formats">
        {AUDIO_FORMATS[tool.slug]![0].map((f) => (
          <span>{f}</span>
        ))}
        <Icon name="right" />
        {AUDIO_FORMATS[tool.slug]![1].map((f) => (
          <span class="acc">{f}</span>
        ))}
      </div>
    ) : app === "audiotool" && tool.slug !== "compress" ? (
      <div class:list={["art-aud", tool.slug]} aria-hidden="true">
        <span class="art-aud-ico">
          <Icon name={tool.icon} />
        </span>
        <span class="art-aud-bars">
          {bars.map((b) => (
            <i class:list={{ on: b.on }} style={`height:${b.h}%`} />
          ))}
        </span>
      </div>
    ) : app === "vidtool" && tool.slug === "convert" ? (
      <div class="art-formats">
        <span>MOV</span>
        <span>MKV</span>
        <Icon name="right" />
        <span class="acc">MP4</span>
        <span class="acc">WebM</span>
      </div>
    ) : app === "pdftool" && tool.slug === "merge" ? (
      <div class="art-pdf">
        <span class="pg a">
          {page().map(() => (
            <i />
          ))}
        </span>
        <span class="pg b">
          {page().map(() => (
            <i />
          ))}
        </span>
        <Icon name="right" />
        <span class="pg stack">
          {page(4).map(() => (
            <i />
          ))}
        </span>
      </div>
    ) : app === "pdftool" && tool.slug === "split" ? (
      <div class="art-pdf">
        <span class="pg stack">
          {page(4).map(() => (
            <i />
          ))}
        </span>
        <Icon name="right" />
        <span class="pg a">
          {page().map(() => (
            <i />
          ))}
        </span>
        <span class="pg b">
          {page().map(() => (
            <i />
          ))}
        </span>
      </div>
    ) : app === "pdftool" &&
      (tool.slug === "organize" || tool.slug === "remove-pages") ? (
      <div class="art-pdf grid6">
        {Array.from({ length: 6 }, (_, i) => (
          <span
            class:list={[
              "pg",
              { lift: i === 2, gone: tool.slug === "remove-pages" && i === 4 },
            ]}
          >
            {page(2).map(() => (
              <i />
            ))}
          </span>
        ))}
      </div>
    ) : app === "pdftool" && tool.slug === "sign" ? (
      <div class="art-pdf">
        <span class="pg big">
          {page(4).map(() => (
            <i />
          ))}
          <Icon name="signature" class="ico sig" />
        </span>
      </div>
    ) : app === "pdftool" && tool.slug === "page-numbers" ? (
      <div class="art-pdf">
        {[1, 2, 3].map((n) => (
          <span class="pg num">
            {page(3).map(() => (
              <i />
            ))}
            <b>{n} / 3</b>
          </span>
        ))}
      </div>
    ) : app === "pdftool" &&
      (tool.slug === "to-image" || tool.slug === "from-image") ? (
      <div class="art-pdf">
        {tool.slug === "from-image" && <span class="photo" />}
        {tool.slug === "from-image" && <Icon name="right" />}
        <span class="pg">
          {page().map(() => (
            <i />
          ))}
        </span>
        {tool.slug === "to-image" && <Icon name="right" />}
        {tool.slug === "to-image" && <span class="photo" />}
      </div>
    ) : app === "pdftool" && tool.slug === "to-text" ? (
      <div class="art-pdf">
        <span class="pg">
          {page(4).map(() => (
            <i />
          ))}
        </span>
        <Icon name="right" />
        <span class="aa">Aa</span>
      </div>
    ) : app === "qrtool" &&
      (tool.slug === "generator" || tool.slug === "bulk") ? (
      <div class="art-qr">
        {(tool.slug === "bulk" ? [0, 1, 2] : [0]).map(() => (
          <span set:html={QR} />
        ))}
      </div>
    ) : app === "vidtool" ? (
      <div class:list={["art-vid", tool.slug]} aria-hidden="true">
        <span class="art-vid-screen">
          <Icon name={tool.icon} />
        </span>
        <span class="art-vid-track">
          <i class="sel" />
          <i class="head" />
        </span>
      </div>
    ) : app === "ocrtool" ? (
      <div class:list={["art-ocr", tool.slug]} aria-hidden="true">
        <span class="art-ocr-src">
          {tool.slug === "image-to-text" || tool.slug === "batch-ocr" ? (
            <>
              <i class="w1" />
              <i class="w2" />
              <i class="w3" />
            </>
          ) : (
            <>
              <i class="w2" />
              <i class="w1" />
              <i class="w3" />
              <i class="w2" />
            </>
          )}
        </span>
        <Icon name="right" />
        <span class="art-ocr-out">
          <b>Aa</b>
          <i />
          <i class="short" />
        </span>
      </div>
    ) : app === "devtool" ? (
      <div class="art-code" aria-hidden="true">
        <span class="art-code-bar">
          <i />
          <i />
          <i />
        </span>
        <code>
          {(SNIPS[tool.slug] ?? ["{ }"]).map((l) => (
            <span>{l}</span>
          ))}
        </code>
      </div>
    ) : app === "qrtool" && tool.slug === "codes-2d" ? (
      <div class="art-qr">
        <span set:html={dm} />
      </div>
    ) : app === "qrtool" && tool.slug === "wifi-card" ? (
      <div class="art-wifi-card">
        <b>Wi-Fi</b>
        <span set:html={QR} />
        <i />
        <i class="short" />
      </div>
    ) : app === "qrtool" && tool.slug === "batch-scan" ? (
      <div class="art-batch">
        <div class="art-qr stack">
          <span set:html={QR} />
          <span set:html={QR} />
          <span set:html={QR} />
        </div>
        <ul>
          {[0, 1, 2, 3].map(() => (
            <li>
              <Icon name="check" />
              <i />
            </li>
          ))}
        </ul>
      </div>
    ) : app === "qrtool" && tool.slug === "checker" ? (
      <div class="art-qr art-check">
        <span set:html={QR} />
        <em>
          <Icon name="check" />
        </em>
      </div>
    ) : app === "qrtool" && tool.slug === "fix-qr" ? (
      <div class="art-qr art-fix">
        <span class="blurry" set:html={QR} />
        <Icon name="right" />
        <span set:html={QR} />
      </div>
    ) : app === "qrtool" && tool.slug === "scanner" ? (
      <div class="art-scan">
        <span class="frame" />
        <span class="line" />
      </div>
    ) : app === "qrtool" && tool.slug === "barcode" ? (
      <div class="art-bars-code">
        {[3, 1, 2, 1, 1, 3, 1, 2, 2, 1, 3, 1, 1, 2, 1, 3, 2, 1, 1, 2, 3, 1].map(
          (w) => (
            <i style={`width:${w * 2}px`} />
          ),
        )}
      </div>
    ) : tool.slug === "compress" ? (
      <div class="art-bars">
        <div>
          <span>{T("Before")}</span>
          <i style="width:100%" />
          <b>4.2 MB</b>
        </div>
        <div>
          <span>{T("After")}</span>
          <i class="acc" style="width:15%" />
          <b>612 KB</b>
        </div>
      </div>
    ) : tool.slug === "resize" ? (
      <div class="art-frames">
        <div class="outer">
          <span>2400 × 1600</span>
          <div class="inner">
            <span>1080 × 720</span>
          </div>
        </div>
      </div>
    ) : tool.slug === "convert" ? (
      <div class="art-formats">
        <span>HEIC</span>
        <span>PNG</span>
        <Icon name="right" />
        <span class="acc">JPG</span>
        <span class="acc">WebP</span>
      </div>
    ) : tool.slug === "strip-metadata" ? (
      <ul class="art-meta">
        <li>
          <span>{T("Location")}</span>
          <s>23.81°N 90.41°E</s>
        </li>
        <li>
          <span>{T("Camera")}</span>
          <s>iPhone 15 Pro</s>
        </li>
      </ul>
    ) : tool.slug === "crop" ? (
      <div class="art-crop">
        <div class="frame">
          <span>1:1</span>
        </div>
      </div>
    ) : tool.slug === "rotate" ? (
      <div class="art-rotate">
        <span class="card a" />
        <Icon name="rotateRight" />
        <span class="card b" />
      </div>
    ) : tool.slug === "remove-bg" || tool.slug === "change-bg" ? (
      <div class:list={["art-cut", { color: tool.slug === "change-bg" }]}>
        <span class="person" />
      </div>
    ) : tool.slug === "passport-photo" ? (
      <div class="art-id">
        <div class="photo">
          <span class="person" />
        </div>
        <div class="lines">
          <b>35 × 45 mm</b>
          <i />
          <i />
          <small>{T("4 × 6 sheet")}</small>
        </div>
      </div>
    ) : tool.slug === "watermark" ? (
      <div class="art-mark">
        <span>{T("© your name")}</span>
        <span>{T("© your name")}</span>
      </div>
    ) : tool.slug === "filters" ? (
      <div class="art-looks">
        <i style="filter:grayscale(1)" />
        <i style="filter:sepia(.8)" />
        <i style="filter:saturate(1.8)" />
        <i style="filter:hue-rotate(160deg)" />
      </div>
    ) : tool.slug === "adjust" ? (
      <div class="art-sliders">
        <span style="--v:70%">{T("Brightness")}</span>
        <span style="--v:40%">{T("Contrast")}</span>
        <span style="--v:85%">{T("Saturation")}</span>
      </div>
    ) : tool.slug === "add-text" ? (
      <div class="art-meme">
        <b>{T("Top text")}</b>
        <b>{T("Bottom text")}</b>
      </div>
    ) : tool.slug === "blur" || tool.slug === "face-blur" ? (
      <div class="art-pixel">
        <span class="px" />
      </div>
    ) : tool.slug === "collage" ? (
      <div class="art-collage">
        <i />
        <i />
        <i />
      </div>
    ) : tool.slug === "split" ? (
      <div class="art-split">
        {Array.from({ length: 9 }, () => (
          <i />
        ))}
      </div>
    ) : tool.slug === "palette" ? (
      <div class="art-palette">
        {["#ff7e7e", "#ffb37a", "#ffe08a", "#7a5cff", "#2a2160"].map((c) => (
          <i style={`background:${c}`} />
        ))}
      </div>
    ) : tool.slug === "beautify" ? (
      <div class="art-window">
        <div class="win">
          <span class="bar">
            <i />
            <i />
            <i />
          </span>
        </div>
      </div>
    ) : tool.slug === "favicon" ? (
      <div class="art-tab">
        <span class="tab">
          <Icon name="star" />
          {T("My site")}
        </span>
        <span class="sizes">
          <i style="width:16px;height:16px" />
          <i style="width:32px;height:32px" />
          <i style="width:48px;height:48px" />
        </span>
      </div>
    ) : tool.slug === "histogram" ? (
      <div class="art-hist">
        {[18, 30, 46, 64, 80, 72, 58, 66, 88, 70, 44, 30, 20, 12].map((h) => (
          <i style={`height:${h}%`} />
        ))}
      </div>
    ) : tool.slug === "extend-canvas" ? (
      <div class="art-extend">
        <i />
      </div>
    ) : tool.slug === "form-size" ? (
      <div class="art-form">
        <span class="ph" />
        <span>
          <b>300 × 300 px</b>
          <small>{T("Under 100 KB")}</small>
        </span>
      </div>
    ) : tool.slug === "base64" ? (
      <code class="art-code">
        data:image/png;base64,iVBORw0KGgoAAAANSUhEUgAAAAEAAAABCAYAAAA…
      </code>
    ) : tool.slug === "gif-frames" ? (
      <div class="art-frames-strip">
        {[0, 1, 2, 3].map((i) => (
          <i style={`--r:${i * 25}deg`} />
        ))}
      </div>
    ) : tool.slug === "image-info" || tool.slug === "exif" ? (
      <ul class="art-meta plain">
        <li>
          <span>{T(tool.slug === "exif" ? "Camera" : "Format")}</span>
          <b>{tool.slug === "exif" ? "iPhone 15 Pro" : "JPEG"}</b>
        </li>
        <li>
          <span>{T(tool.slug === "exif" ? "Taken" : "Size")}</span>
          <b>{tool.slug === "exif" ? "12 Mar 2026" : "4032 × 3024"}</b>
        </li>
        <li>
          <span>{T(tool.slug === "exif" ? "Location" : "Ratio")}</span>
          <b>{tool.slug === "exif" ? "23.81°N 90.41°E" : "4:3"}</b>
        </li>
      </ul>
    ) : tool.slug === "color-picker" ? (
      <div class="art-picker">
        <i />
        <span>#ff7e7e</span>
      </div>
    ) : tool.slug === "border" ? (
      <div class="art-border">
        <i />
      </div>
    ) : tool.slug === "signature" ? (
      <div class="art-sign">
        <Icon name="signature" />
      </div>
    ) : (
      <span class="tile">
        <Icon name={tool.icon} />
      </span>
    )}
  </div>
  <div class="feat-body">
    <span class="tile">
      <Icon name={tool.icon} />
    </span>
    <div>
      <strong>{tool.name}</strong>
      <p>{tool.blurb}</p>
    </div>
    <Icon name="right" class="ico go" />
  </div>
</a>
