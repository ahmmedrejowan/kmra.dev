---
import type { Tool } from "@kmra/registry";
import Icon from "./Icon.astro";

interface Props {
  tool: Tool;
  /** Duplicate copy in a scrolling row: hidden from assistive tech and keyboard */
  hidden?: boolean;
}

const { tool, hidden = false } = Astro.props;
// Each app is built with its own site URL (imgtool.kmra.dev, pdftool.kmra.dev, ...)
const app = Astro.site?.hostname.split(".")[0] ?? "imgtool";
const page = (lines = 3) => Array.from({ length: lines });
---

<a
  class="feat"
  href={`/${tool.slug}`}
  aria-hidden={hidden ? "true" : undefined}
  tabindex={hidden ? -1 : undefined}
>
  <div class="feat-art" aria-hidden="true">
    {app === "pdftool" && tool.slug === "merge" ? (
      <div class="art-pdf">
        <span class="pg a">
          {page().map(() => (
            <i />
          ))}
        </span>
        <span class="pg b">
          {page().map(() => (
            <i />
          ))}
        </span>
        <Icon name="right" />
        <span class="pg stack">
          {page(4).map(() => (
            <i />
          ))}
        </span>
      </div>
    ) : app === "pdftool" && tool.slug === "split" ? (
      <div class="art-pdf">
        <span class="pg stack">
          {page(4).map(() => (
            <i />
          ))}
        </span>
        <Icon name="right" />
        <span class="pg a">
          {page().map(() => (
            <i />
          ))}
        </span>
        <span class="pg b">
          {page().map(() => (
            <i />
          ))}
        </span>
      </div>
    ) : app === "pdftool" &&
      (tool.slug === "organize" || tool.slug === "remove-pages") ? (
      <div class="art-pdf grid6">
        {Array.from({ length: 6 }, (_, i) => (
          <span
            class:list={[
              "pg",
              { lift: i === 2, gone: tool.slug === "remove-pages" && i === 4 },
            ]}
          >
            {page(2).map(() => (
              <i />
            ))}
          </span>
        ))}
      </div>
    ) : app === "pdftool" && tool.slug === "sign" ? (
      <div class="art-pdf">
        <span class="pg big">
          {page(4).map(() => (
            <i />
          ))}
          <Icon name="signature" class="ico sig" />
        </span>
      </div>
    ) : app === "pdftool" && tool.slug === "page-numbers" ? (
      <div class="art-pdf">
        {[1, 2, 3].map((n) => (
          <span class="pg num">
            {page(3).map(() => (
              <i />
            ))}
            <b>{n} / 3</b>
          </span>
        ))}
      </div>
    ) : app === "pdftool" &&
      (tool.slug === "to-image" || tool.slug === "from-image") ? (
      <div class="art-pdf">
        {tool.slug === "from-image" && <span class="photo" />}
        {tool.slug === "from-image" && <Icon name="right" />}
        <span class="pg">
          {page().map(() => (
            <i />
          ))}
        </span>
        {tool.slug === "to-image" && <Icon name="right" />}
        {tool.slug === "to-image" && <span class="photo" />}
      </div>
    ) : app === "pdftool" && tool.slug === "to-text" ? (
      <div class="art-pdf">
        <span class="pg">
          {page(4).map(() => (
            <i />
          ))}
        </span>
        <Icon name="right" />
        <span class="aa">Aa</span>
      </div>
    ) : app === "qrtool" &&
      (tool.slug === "generator" || tool.slug === "bulk") ? (
      <div class="art-qr">
        {(tool.slug === "bulk" ? [0, 1, 2] : [0]).map(() => (
          <span
            set:html={`<svg viewBox="0 0 21 21"><path fill="currentColor" fill-rule="evenodd" d="M0 0h7v7H0zM1 1v5h5V1zM2 2h3v3H2zM14 0h7v7h-7zM15 1v5h5V1zM16 2h3v3h-3zM0 14h7v7H0zM1 15v5h5v-5zM2 16h3v3H2zM9 1h2v2H9zM9 5h1v3H9zM12 9h3v1h-3zM9 9h2v2H9zM17 9h3v2h-3zM9 13h3v2H9zM14 14h2v3h-2zM18 16h3v2h-3zM10 18h3v3h-3zM16 19h2v2h-2zM1 9h3v2H1zM5 10h2v1H5z"/></svg>`}
          />
        ))}
      </div>
    ) : app === "qrtool" && tool.slug === "scanner" ? (
      <div class="art-scan">
        <span class="frame" />
        <span class="line" />
      </div>
    ) : app === "qrtool" && tool.slug === "barcode" ? (
      <div class="art-bars-code">
        {[3, 1, 2, 1, 1, 3, 1, 2, 2, 1, 3, 1, 1, 2, 1, 3, 2, 1, 1, 2, 3, 1].map(
          (w) => (
            <i style={`width:${w * 2}px`} />
          ),
        )}
      </div>
    ) : tool.slug === "compress" ? (
      <div class="art-bars">
        <div>
          <span>Before</span>
          <i style="width:100%" />
          <b>4.2 MB</b>
        </div>
        <div>
          <span>After</span>
          <i class="acc" style="width:15%" />
          <b>612 KB</b>
        </div>
      </div>
    ) : tool.slug === "resize" ? (
      <div class="art-frames">
        <div class="outer">
          <span>2400 × 1600</span>
          <div class="inner">
            <span>1080 × 720</span>
          </div>
        </div>
      </div>
    ) : tool.slug === "convert" ? (
      <div class="art-formats">
        <span>HEIC</span>
        <span>PNG</span>
        <Icon name="right" />
        <span class="acc">JPG</span>
        <span class="acc">WebP</span>
      </div>
    ) : tool.slug === "strip-metadata" ? (
      <ul class="art-meta">
        <li>
          <span>Location</span>
          <s>23.81°N 90.41°E</s>
        </li>
        <li>
          <span>Camera</span>
          <s>iPhone 15 Pro</s>
        </li>
      </ul>
    ) : tool.slug === "crop" ? (
      <div class="art-crop">
        <div class="frame">
          <span>1:1</span>
        </div>
      </div>
    ) : tool.slug === "rotate" ? (
      <div class="art-rotate">
        <span class="card a" />
        <Icon name="rotateRight" />
        <span class="card b" />
      </div>
    ) : tool.slug === "remove-bg" || tool.slug === "change-bg" ? (
      <div class:list={["art-cut", { color: tool.slug === "change-bg" }]}>
        <span class="person" />
      </div>
    ) : tool.slug === "passport-photo" ? (
      <div class="art-id">
        <div class="photo">
          <span class="person" />
        </div>
        <div class="lines">
          <b>35 × 45 mm</b>
          <i />
          <i />
          <small>4 × 6 sheet</small>
        </div>
      </div>
    ) : tool.slug === "watermark" ? (
      <div class="art-mark">
        <span>© your name</span>
        <span>© your name</span>
      </div>
    ) : tool.slug === "filters" ? (
      <div class="art-looks">
        <i style="filter:grayscale(1)" />
        <i style="filter:sepia(.8)" />
        <i style="filter:saturate(1.8)" />
        <i style="filter:hue-rotate(160deg)" />
      </div>
    ) : tool.slug === "adjust" ? (
      <div class="art-sliders">
        <span style="--v:70%">Brightness</span>
        <span style="--v:40%">Contrast</span>
        <span style="--v:85%">Saturation</span>
      </div>
    ) : tool.slug === "add-text" ? (
      <div class="art-meme">
        <b>Top text</b>
        <b>Bottom text</b>
      </div>
    ) : tool.slug === "blur" || tool.slug === "face-blur" ? (
      <div class="art-pixel">
        <span class="px" />
      </div>
    ) : tool.slug === "collage" ? (
      <div class="art-collage">
        <i />
        <i />
        <i />
      </div>
    ) : tool.slug === "split" ? (
      <div class="art-split">
        {Array.from({ length: 9 }, () => (
          <i />
        ))}
      </div>
    ) : tool.slug === "palette" ? (
      <div class="art-palette">
        {["#ff7e7e", "#ffb37a", "#ffe08a", "#7a5cff", "#2a2160"].map((c) => (
          <i style={`background:${c}`} />
        ))}
      </div>
    ) : tool.slug === "beautify" ? (
      <div class="art-window">
        <div class="win">
          <span class="bar">
            <i />
            <i />
            <i />
          </span>
        </div>
      </div>
    ) : tool.slug === "favicon" ? (
      <div class="art-tab">
        <span class="tab">
          <Icon name="star" />
          My site
        </span>
        <span class="sizes">
          <i style="width:16px;height:16px" />
          <i style="width:32px;height:32px" />
          <i style="width:48px;height:48px" />
        </span>
      </div>
    ) : tool.slug === "histogram" ? (
      <div class="art-hist">
        {[18, 30, 46, 64, 80, 72, 58, 66, 88, 70, 44, 30, 20, 12].map((h) => (
          <i style={`height:${h}%`} />
        ))}
      </div>
    ) : tool.slug === "extend-canvas" ? (
      <div class="art-extend">
        <i />
      </div>
    ) : tool.slug === "form-size" ? (
      <div class="art-form">
        <span class="ph" />
        <span>
          <b>300 × 300 px</b>
          <small>Under 100 KB</small>
        </span>
      </div>
    ) : tool.slug === "base64" ? (
      <code class="art-code">
        data:image/png;base64,iVBORw0KGgoAAAANSUhEUgAAAAEAAAABCAYAAAA…
      </code>
    ) : tool.slug === "gif-frames" ? (
      <div class="art-frames-strip">
        {[0, 1, 2, 3].map((i) => (
          <i style={`--r:${i * 25}deg`} />
        ))}
      </div>
    ) : tool.slug === "image-info" || tool.slug === "exif" ? (
      <ul class="art-meta plain">
        <li>
          <span>{tool.slug === "exif" ? "Camera" : "Format"}</span>
          <b>{tool.slug === "exif" ? "iPhone 15 Pro" : "JPEG"}</b>
        </li>
        <li>
          <span>{tool.slug === "exif" ? "Taken" : "Size"}</span>
          <b>{tool.slug === "exif" ? "12 Mar 2026" : "4032 × 3024"}</b>
        </li>
        <li>
          <span>{tool.slug === "exif" ? "Location" : "Ratio"}</span>
          <b>{tool.slug === "exif" ? "23.81°N 90.41°E" : "4:3"}</b>
        </li>
      </ul>
    ) : tool.slug === "color-picker" ? (
      <div class="art-picker">
        <i />
        <span>#ff7e7e</span>
      </div>
    ) : tool.slug === "border" ? (
      <div class="art-border">
        <i />
      </div>
    ) : tool.slug === "signature" ? (
      <div class="art-sign">
        <Icon name="signature" />
      </div>
    ) : (
      <span class="tile">
        <Icon name={tool.icon} />
      </span>
    )}
  </div>
  <div class="feat-body">
    <span class="tile">
      <Icon name={tool.icon} />
    </span>
    <div>
      <strong>{tool.name}</strong>
      <p>{tool.blurb}</p>
    </div>
    <Icon name="right" class="ico go" />
  </div>
</a>
