---
import { CONTACT } from "@kmra/registry";
import Icon from "./Icon.astro";
import { pageLocale } from "../lib/locale";
import { num, t as tr } from "../lib/i18n";

/** `noFiles`: the app works on what you type (calculators, colours), not files */
interface Props {
  noFiles?: boolean;
  /** With noFiles: the app listens through the microphone (music) */
  listens?: boolean;
}
const { noFiles = false, listens = false } = Astro.props;
const locale = pageLocale(Astro);
const T = (s: string) => tr(locale, s);

const steps = [
  {
    icon: "download",
    title: "You open a tool",
    text: "Your browser downloads the tool's code once, like any web page.",
  },
  {
    icon: "zap",
    title: "Your browser does the work",
    text: listens
      ? "What the microphone hears is analysed in your device's memory and never recorded."
      : noFiles
      ? "What you type is worked out in your device's memory, right in the page."
      : "Your file is read and edited in your device's memory. It isn't sent anywhere.",
  },
  {
    icon: "check",
    title: noFiles ? "You get the result" : "You save the result",
    text: noFiles
      ? "Results appear as you type, ready to copy or save."
      : "The finished file goes straight to your downloads. Your original stays untouched.",
  },
] as const;
---

<ol class="timeline">
  {steps.map((s, i) => (
    <li>
      <span class="tl-dot">{num(locale, i + 1)}</span>
      <div class="tl-body">
        <span class="tile">
          <Icon name={s.icon} />
        </span>
        <div>
          <strong>{T(s.title)}</strong>
          <p>{T(s.text)}</p>
        </div>
      </div>
    </li>
  ))}
</ol>

<div class="duo">
  <section class="card-block">
    <span class="tile">
      <Icon name="shield" />
    </span>
    <h2>{T("Blocked by design")}</h2>
    <p>
      {T(
        listens
          ? "Every kmra site sends a security policy that stops the page from contacting any other server. Even if there were a bug, your browser would refuse to send the sound anywhere."
          : noFiles
          ? "Every kmra site sends a security policy that stops the page from contacting any other server. Even if there were a bug, your browser would refuse to send what you type anywhere."
          : "Every kmra site sends a security policy that stops the page from contacting any other server. Even if there were a bug, your browser would refuse to send your file anywhere.",
      )}
    </p>
  </section>
  <section class="card-block">
    <span class="tile">
      <Icon name="search" />
    </span>
    <h2>{T("Check it yourself")}</h2>
    <ol class="mini-steps">
      <li>{T("Open your browser's developer tools.")}</li>
      <li>{T("Choose the Network tab.")}</li>
      <li>
        {noFiles
          ? T("Use any tool. Nothing is sent while it works.")
          : T("Use any tool. Nothing is sent while your file is processed.")}
      </li>
    </ol>
  </section>
</div>

<p class="page-note">
  {T("Questions? Email")}{" "}
  <a href={`mailto:${CONTACT.email}`}>{CONTACT.email}</a>
  {locale === "bn" ? "।" : "."}
</p>
