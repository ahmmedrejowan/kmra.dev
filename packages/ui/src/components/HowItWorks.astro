---
import { CONTACT } from "@kmra/registry";
import Icon from "./Icon.astro";

const steps = [
  {
    icon: "download",
    title: "You open a tool",
    text: "Your browser downloads the tool's code once, like any web page.",
  },
  {
    icon: "zap",
    title: "Your browser does the work",
    text: "Your file is read and edited in your device's memory. It isn't sent anywhere.",
  },
  {
    icon: "check",
    title: "You save the result",
    text: "The finished file goes straight to your downloads. Your original stays untouched.",
  },
] as const;
---

<ol class="timeline">
  {steps.map((s, i) => (
    <li>
      <span class="tl-dot">{i + 1}</span>
      <div class="tl-body">
        <span class="tile">
          <Icon name={s.icon} />
        </span>
        <div>
          <strong>{s.title}</strong>
          <p>{s.text}</p>
        </div>
      </div>
    </li>
  ))}
</ol>

<div class="duo">
  <section class="card-block">
    <span class="tile">
      <Icon name="shield" />
    </span>
    <h2>Blocked by design</h2>
    <p>
      Every kmra site sends a security policy that stops the page from
      contacting any other server. Even if there were a bug, your browser would
      refuse to send your file anywhere.
    </p>
  </section>
  <section class="card-block">
    <span class="tile">
      <Icon name="search" />
    </span>
    <h2>Check it yourself</h2>
    <ol class="mini-steps">
      <li>Open your browser's developer tools.</li>
      <li>Choose the Network tab.</li>
      <li>Use any tool. Nothing is sent while your file is processed.</li>
    </ol>
  </section>
</div>

<p class="page-note">
  Questions? Email <a href={`mailto:${CONTACT.email}`}>{CONTACT.email}</a>.
</p>
