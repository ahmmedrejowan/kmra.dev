---
import { apps, appUrl, type AppId } from "@kmra/registry";

interface Props {
  appId: AppId;
}

const { appId } = Astro.props;
const dev = import.meta.env.DEV;
const others = apps.filter((a) => a.id !== appId);
---

{others.length > 0 && (
  <div class="grid gap-4">
    {others.map((a) => {
      const ready = a.tools.filter((t) => t.ready).length;
      return (
        <a
          href={appUrl(a.id, "/", dev)}
          class="mat ruler block rounded-lg px-6 pt-9 pb-7 sm:px-8"
          style={`--mat:${a.mat}`}
        >
          <span class="font-wide text-2xl font-extrabold tracking-tight">
            {a.name}
          </span>
          <span class="mt-2 block max-w-xl text-on-mat-muted">{a.tagline}</span>
          <span class="mt-5 flex flex-wrap gap-x-6 gap-y-1 text-sm">
            <span>
              {ready > 0
                ? `${ready} of ${a.tools.length} tools ready`
                : "Tools in the works"}
            </span>
            <span class="text-on-mat-muted">{a.id}.kmra.dev</span>
          </span>
        </a>
      );
    })}
  </div>
)}
