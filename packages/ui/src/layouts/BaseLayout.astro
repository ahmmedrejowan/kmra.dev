---
import "../styles.css";
import { allPages, apps, getApp, linkTo, type AppId } from "@kmra/registry";
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
import CommandPalette, { type PaletteItem } from "../components/CommandPalette";

interface Props {
  appId: AppId;
  title: string;
  description?: string;
}

const { appId, title, description } = Astro.props;
const app = getApp(appId);
const dev = import.meta.env.DEV;
const pageDescription = description ?? app.tagline;
// Clean URL (no .html / trailing slash) to match Vercel cleanUrls + trailingSlash: false
const path = Astro.url.pathname
  .replace(/(index)?\.html$/, "")
  .replace(/(.)\/$/, "$1");
const accentStyle = `--acc-l:${app.accent.light};--acc-d:${app.accent.dark};--acc-soft-l:${app.accent.softLight};--acc-soft-d:${app.accent.softDark}`;

// Current app first, then other live apps.
const appName = (id: AppId) => apps.find((a) => a.id === id)?.short ?? id;
const pages = allPages().sort(
  (a, b) => Number(b.app === appId) - Number(a.app === appId),
);
const paletteItems: PaletteItem[] = [
  ...pages.map((p) => ({
    group:
      p.app === appId
        ? p.kind === "task"
          ? "Use cases"
          : "Tools"
        : `${appName(p.app)} tools`,
    name: p.name,
    hint: p.kind === "task" ? p.hint : p.ready ? appName(p.app) : "Soon",
    href: linkTo(appId, p.app, `/${p.slug}`, dev),
    icon: p.icon,
  })),
  {
    group: "Help",
    name: "How it works",
    hint: "Privacy",
    href: "/how-it-works",
    icon: "shield",
  },
];
---

<!doctype html>
<html lang="en" style={accentStyle}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={pageDescription} />
    <meta name="theme-color" content={app.accent.light} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    {Astro.site && <link rel="canonical" href={new URL(path, Astro.site)} />}
    <meta property="og:title" content={title} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:type" content="website" />
    <script is:inline>
      try {
        const t = localStorage.getItem("kmra-theme");
        if (t === "dark" || t === "light")
          document.documentElement.dataset.theme = t;
      } catch {}
    </script>
  </head>
  <body>
    <a href="#main" class="sr-only skip">
      Skip to content
    </a>
    <SiteHeader appId={appId} />
    <main id="main">
      <slot />
    </main>
    <SiteFooter appId={appId} />
    <CommandPalette client:idle items={paletteItems} />
  </body>
</html>
