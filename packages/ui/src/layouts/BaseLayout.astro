---
import "../styles.css";
import {
  allPages,
  appOrigin,
  apps,
  brandName,
  getApp,
  HUB,
  type AppId,
} from "@kmra/registry";
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
import CommandPalette, { type PaletteItem } from "../components/CommandPalette";
import MoreAppsCta from "../components/MoreAppsCta.astro";
import Shortcuts from "../components/Shortcuts";
// Cookieless page counts, served from the site's own domain on Vercel (allowed by the CSP)
import Analytics from "@vercel/analytics/astro";
import Stats from "../components/Stats.astro";
import { localizeApp } from "@kmra/registry";
import { appLink, hubLink, langLinks, pageLocale } from "../lib/locale";
import { LOCALES, lp, t as tr } from "../lib/i18n";
import "@fontsource/noto-sans-bengali/400.css";
import "@fontsource/noto-sans-bengali/600.css";
import "@fontsource/noto-sans-bengali/700.css";

interface Props {
  appId: AppId;
  /** Page title without the brand; the brand is appended */
  title: string;
  description?: string;
  /** OG image slug under /og/; defaults to the page path ("index" for /) */
  og?: string;
  /** Keep the page out of search results (e.g. 404) */
  noindex?: boolean;
  /** Extra JSON-LD objects for this page */
  schema?: Record<string, unknown>[];
}

const {
  appId,
  title,
  description,
  og,
  noindex = false,
  schema = [],
} = Astro.props;
// Language comes from the URL (/bn/... is Bangla); hreflang links come from the app's languages.
const lang = pageLocale(Astro);
const T = (s: string) => tr(lang, s);
const app = localizeApp(getApp(appId), lang);
const alternates = langLinks(Astro, app);
const brand = brandName(app);
const dev = import.meta.env.DEV;
const site = Astro.site ?? new URL(appOrigin(appId));
// Short descriptions get the app's promise added, so search results and link previews have a
// full sentence or two (about 100–160 characters)
const baseDescription = description ?? app.tagline;
const promise = T(
  app.listens
    ? "Free, runs in your browser, and what you play stays on your device."
    : app.noFiles
      ? "Free, runs in your browser, and what you type stays on your device."
      : "Free, runs in your browser, and your files stay on your device.",
);
const pageDescription =
  baseDescription.length < 100
    ? `${baseDescription}${/[.!?।]$/.test(baseDescription) ? "" : lang === "bn" ? "।" : "."} ${promise}`
    : baseDescription;
// Clean URL (no .html / trailing slash) to match Vercel cleanUrls + trailingSlash: false
const path = Astro.url.pathname
  .replace(/(index)?\.html$/, "")
  .replace(/(.)\/$/, "$1");
const canonical = new URL(path, site).toString();
// Translated pages share the English page's preview image
const basePath = path.replace(new RegExp(`^/${lang}(?=/|$)`), "") || "/";
const ogSlug = og ?? (basePath === "/" ? "index" : basePath.slice(1));
const ogImage = new URL(`/og/${ogSlug}.png`, site).toString();
const fullTitle = `${title} · ${brand}`;
const accentStyle = `--acc-l:${app.accent.light};--acc-d:${app.accent.dark};--acc-soft-l:${app.accent.softLight};--acc-soft-d:${app.accent.softDark}`;

const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "WebSite",
    name: `${brand} by kmra.dev`,
    url: site.toString(),
    description: app.tagline,
    publisher: {
      "@type": "Organization",
      name: "kmra.dev",
      url: "https://kmra.dev",
    },
  },
  ...schema,
];

// Current app first, then other live apps.
const appName = (id: AppId) =>
  localizeApp(
    apps.find((a) => a.id === id)!,
    lang,
  ).short ?? id;
const pages = allPages(lang).sort(
  (a, b) => Number(b.app === appId) - Number(a.app === appId),
);
const paletteItems: PaletteItem[] = [
  ...pages.map((p) => ({
    group:
      p.app === appId
        ? p.kind === "task"
          ? T("Use cases")
          : T("Tools")
        : tr(lang, "{app} tools", { app: appName(p.app) }),
    name: p.name,
    hint: p.kind === "task" ? p.hint : p.ready ? appName(p.app) : T("Soon"),
    href: appLink(appId, lang, p.app, `/${p.slug}`, dev),
    icon: p.icon,
  })),
  ...(appId === "imgtool"
    ? [
        {
          group: T("Tools"),
          name: T("Image editor"),
          hint: T("All tools"),
          href: lp(lang, "/editor"),
          icon: "sliders" as const,
        },
      ]
    : []),
  {
    group: T("Help"),
    name: T("All tools"),
    hint: brand,
    href: lp(lang, "/tools"),
    icon: "grid",
  },
  ...(app.tasks.length
    ? [
        {
          group: T("Help"),
          name: T("Use cases"),
          hint: brand,
          href: lp(lang, "/use-cases"),
          icon: "layers" as const,
        },
      ]
    : []),
  {
    group: T("Help"),
    name: T("More tools from kmra"),
    hint: "kmra.dev",
    href: lp(lang, "/more-tools"),
    icon: "zap",
  },
  ...(HUB.live
    ? [
        {
          group: T("Help"),
          name: T("Every app on kmra.dev"),
          hint: "kmra.dev",
          href: hubLink(lang, "/", dev),
          icon: "grid" as const,
        },
      ]
    : []),
  {
    group: T("Help"),
    name: T("How it works"),
    hint: T("Privacy"),
    href: lp(lang, "/how-it-works"),
    icon: "shield",
  },
  {
    group: T("Help"),
    name: T("Privacy"),
    hint: T("What we store"),
    href: lp(lang, "/privacy"),
    icon: "shield",
  },
  {
    group: T("Help"),
    name: T("About"),
    hint: brand,
    href: lp(lang, "/about"),
    icon: "layers",
  },
  {
    group: T("Help"),
    name: T("Keyboard shortcuts"),
    hint: "?",
    href: "#shortcuts",
    icon: "sliders",
  },
];
---

<!doctype html>
<html lang={lang} style={accentStyle}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <!-- Bing Webmaster Tools ownership (same code for every kmra app); keep it to stay verified -->
    <meta name="msvalidate.01" content="1A20507FD30F025DFEDE13A418175F01" />
    <title>{fullTitle}</title>
    <meta name="description" content={pageDescription} />
    <meta
      name="robots"
      content={noindex ? "noindex, follow" : "index, follow"}
    />
    {!noindex && <link rel="canonical" href={canonical} />}
    <meta name="application-name" content={brand} />
    <meta name="apple-mobile-web-app-title" content={brand} />
    <meta name="theme-color" content={app.accent.light} />
    <meta name="color-scheme" content="light dark" />

    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <link rel="sitemap" type="application/xml" href="/sitemap.xml" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={`${brand} by kmra.dev`} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${title}, ${brand} by kmra.dev`} />
    <meta
      property="og:locale"
      content={LOCALES.find((l) => l.code === lang)?.og ?? "en_US"}
    />
    {alternates.length > 1 && (
      <>
        {alternates.map((a) => (
          <link
            rel="alternate"
            hreflang={a.code}
            href={new URL(a.href, site).toString()}
          />
        ))}
        <link
          rel="alternate"
          hreflang="x-default"
          href={new URL(
            alternates.find((a) => a.code === "en")!.href,
            site,
          ).toString()}
        />
      </>
    )}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={pageDescription} />
    <meta name="twitter:image" content={ogImage} />

    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    <script is:inline>
      try {
        const t = localStorage.getItem("kmra-theme");
        if (t === "dark" || t === "light")
          document.documentElement.dataset.theme = t;
      } catch {}
    </script>
  </head>
  <body>
    <a href="#main" class="sr-only skip">
      {T("Skip to content")}
    </a>
    <SiteHeader appId={appId} />
    <main id="main">
      <slot />
    </main>
    {!/^\/(?:[a-z]{2}\/)?more-tools$/.test(path) && (
      <aside class="wrap cta-wrap" aria-label={T("More from kmra")}>
        <MoreAppsCta appId={appId} />
      </aside>
    )}
    <SiteFooter appId={appId} />
    <CommandPalette client:idle items={paletteItems} lang={lang} />
    <Shortcuts client:idle lang={lang} />
    <Analytics />
    <Stats />
    <script is:inline>
      // Offline support: the service worker caches every page and tool (production only)
      if (
        "serviceWorker" in navigator &&
        !/^(localhost|127\.0\.0\.1)$/.test(location.hostname)
      ) {
        addEventListener("load", () =>
          navigator.serviceWorker.register("/sw.js").catch(() => {}),
        );
      }
    </script>
    <script>
      // Show shortcut hints with the visitor's keys (⌘ on Apple devices, Ctrl elsewhere)
      import { formatKeys } from "../lib/keys";
      document.querySelectorAll<HTMLElement>("[data-keys]").forEach((el) => {
        el.textContent = formatKeys(el.dataset.keys ?? "");
      });
    </script>
  </body>
</html>
