---
import "../styles.css";
import { getApp, type AppId } from "@kmra/registry";
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";

interface Props {
  appId: AppId;
  title?: string;
  description?: string;
  /** Current tool slug, for nav highlighting */
  current?: string;
}

const { appId, title, description, current } = Astro.props;
const app = getApp(appId);
const pageTitle = title ?? `${app.name} · kmra`;
const pageDescription = description ?? app.tagline;
// Clean URL (no .html / trailing slash) to match Vercel cleanUrls + trailingSlash: false
const path = Astro.url.pathname
  .replace(/(index)?\.html$/, "")
  .replace(/(.)\/$/, "$1");
---

<!doctype html>
<html lang="en" style={`--mat:${app.mat}`}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />
    <meta name="theme-color" content={app.mat} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    {Astro.site && <link rel="canonical" href={new URL(path, Astro.site)} />}
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
  </head>
  <body class="flex min-h-dvh flex-col font-sans antialiased">
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:absolute focus:m-2 focus:bg-marker focus:px-3 focus:py-2 focus:text-ink"
    >
      Skip to content
    </a>
    <SiteHeader appId={appId} current={current} />
    <main id="main" class="flex-1">
      <slot />
    </main>
    <SiteFooter appId={appId} />
  </body>
</html>
