node_modules/
dist/
.astro/
.turbo/
.vercel/
.wrangler/
*.log
.env
.env.*
!.env.example
.DS_Store


# Local test images (downloaded, never committed)
apps/*/public/test-fixtures/

# pdf.js runtime files, copied from node_modules at build time
apps/pdftool/public/pdfjs/
apps/ocrtool/public/pdfjs/

# ffmpeg.wasm core (js + wasm), copied from node_modules at build time
apps/vidtool/public/ffmpeg/

# tesseract.js worker and wasm cores, copied from node_modules at build time (language data is committed)
apps/ocrtool/public/tesseract/*
!apps/ocrtool/public/tesseract/lang/

# Test files: generated each run, or local-only (unknown licences)
tests/fixtures/gen/
tests/fixtures/local/
test-results/
playwright-report/
tests/test-results/
